import { Tokens } from "tokens.slint";
import { ActionArea, StatusDot } from "controls.slint";
import { GridBackdrop, TopoBackdrop, GlowPanel } from "backdrop.slint";
import { MainButton, MainSelect, Spinner, MainMotion, MainText } from "main-controls.slint";

export struct Room {id: string, name: string, description: string, players: int, ready: string, join: string, joinable: bool }
export struct MainData {
    online: bool, updating: bool, maintenance: string, rooms-available: bool,
    players: string, ping: string, region: string, location: string,
    installed: string, latest: string, size: string, checked: bool, checking: bool,
    needs-setup: bool, needs-update: bool, check-error: string,
    phase: string, launching: bool, launch-status: string, progress: int, launch-error: string,
    can-workshop: bool, profile-changing: bool, profile-blocked: bool, profile-error: string, pending-room: bool,
}

component SmallLabel inherits Text {
    font-size: 10px; letter-spacing: 1.4px; color: Tokens.muted-foreground;
    vertical-alignment: center;
}
component PackageRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> highlight: false;
    in property <bool> last: false;
    height: Tokens.line-height(16.5px, 1phx) + 8px + (root.last ? 0px : 1phx);
    SmallLabel { x: 0px; y: 0px;text: root.label; height: Tokens.line-height(16.5px, 1phx); }
    Text { x: 0px; y: 0px;text: root.value; width: parent.width; height: Tokens.line-height(16.5px, 1phx); horizontal-alignment: right; vertical-alignment: center; font-size: 11px; letter-spacing: 1.32px; color: root.highlight ? Tokens.primary : Tokens.neutral-100; }
    // CSS dash length follows the physical border width under WebKit zoom.
    for dash in Math.ceil(root.width / 6phx): Rectangle { x: dash * 6phx; y: parent.height - 1phx; width: 3phx; height: 1phx; background: root.last ? transparent : Tokens.secondary; }
}
component Metric inherits Rectangle {
    in property <string> tooltip;
    Tooltip { text: @markdown("\{root.tooltip}"); }
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <image> icon;
    width: Math.max(58px, Math.max(metric-label.preferred-width, value.preferred-width + sub.preferred-width + 4px));
    height: 64px;
    metric-label := HorizontalLayout { x: 0px;
        y: (64px - 18px - Tokens.line-height(22px, 1phx)) / 2; height: 14px; spacing: 6px; alignment: end;
        Image { width: 14px; height: 14px; source: root.icon; colorize: Tokens.muted-foreground; }
        SmallLabel { text: root.label; font-size: 9px; letter-spacing: 1.44px; }
    }
    HorizontalLayout { x: 0px;
        y: (64px - 18px - Tokens.line-height(22px, 1phx)) / 2 + 18px; height: Tokens.line-height(22px, 1phx); spacing: 4px; alignment: end;
        value := Text { text: root.value; font-size: 22px; letter-spacing: 1.76px; color: #fafafa; vertical-alignment: center; }
        sub := SmallLabel { text: root.sub; letter-spacing: 1.6px; vertical-alignment: bottom; }
    }
}
component Feature inherits Rectangle {
    height: detail.y + detail.preferred-height;
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    Rectangle { x: 0px;y: 2px; width: 28px; height: 28px; background: Tokens.card; border-width: 1phx; border-color: Tokens.border;
        Image { x: 7px; y: 7px; width: 14px; height: 14px; source: root.icon; colorize: Tokens.primary; }
    }
    Text { y: 0px;x: 40px; width: parent.width - 40px; height: Tokens.line-height(16.5px, 1phx); text: root.title; font-size: 11px; letter-spacing: 1.32px; color: Tokens.neutral-100; }
    detail := Text { x: 40px; y: 20.5px; width: parent.width - 40px; text: root.description; font-size: 11px; color: Tokens.muted-foreground; wrap: word-wrap; line-height-factor: 1.375 * 2048 / 2478; }
}

export component MainScreen inherits Rectangle {
    in property <MainData> data;
    in property <[Room]> rooms;
    in property <[string]> room-names;
    in-out property <bool> workshop: false;
    in-out property <int> room-index: 0;
    in-out property <int> details-view: 0;
    in-out property <string> room-message;
    in-out property <bool> error-details: false;
    callback deploy();
    callback verify();
    callback join(string);
    private property <bool> game-busy: root.data.phase != "idle";
    private property <bool> disabled: !root.data.checked || root.data.checking || root.data.launching || root.game-busy || root.data.profile-changing || root.data.profile-blocked;
    private property <bool> room-disabled: root.data.launching || (root.data.phase != "running" && (root.data.checking || !root.data.checked || root.game-busy));
    private property <bool> banner: root.room-message != "" || (root.workshop && root.data.pending-room);
    private property <Room> room: root.rooms[root.room-index];
    private property <string> state-text: root.data.checking ? "ПРОВЕРКА..." : root.data.check-error != "" ? "НЕ ПРОВЕРЕН" : root.data.needs-setup ? (root.data.needs-update ? "ДОСТУПНО ОБНОВЛЕНИЕ" : "ТРЕБУЕТСЯ ПОДГОТОВКА") : "АКТУАЛЕН";
    private property <color> state-color: root.data.checking ? Tokens.secondary-foreground : root.data.check-error != "" || root.data.needs-setup ? Tokens.primary : Tokens.success;
    private property <string> launch-label: root.game-busy ? (root.data.phase == "running" ? "В ИГРЕ" : root.data.phase == "finishing" ? "ЗАВЕРШЕНИЕ" : root.data.phase == "unknown" ? "ПРОВЕРКА…" : "ЗАПУСК") : root.data.launching ? "ЗАПУСК" : root.data.launch-error != "" ? "ПОВТОРИТЬ" : !root.data.checked ? "..." : root.data.needs-setup ? (root.data.needs-update ? "ОБНОВИТЬ" : "ПОДГОТОВИТЬ") : "ИГРАТЬ";
    private property <string> launch-sub: root.data.phase == "running" ? "Игра запущена" : root.data.phase == "finishing" ? "Команды после выхода" : root.data.launching ? MainText.launch-sub(root.data.launch-status, root.data.progress) : root.data.launch-error != "" ? "Подробности ниже" : !root.data.checked ? "ПРОВЕРКА..." : root.data.needs-setup ? (root.data.needs-update ? "ДОСТУПНО ОБНОВЛЕНИЕ" : "ТРЕБУЕТСЯ ПОДГОТОВКА") : "ПОДКЛЮЧЕНИЕ К СЕРВЕРУ";
    background: Tokens.background;
    TopoBackdrop { x: 0px; y: 0px;}
    GridBackdrop { x: 0px; y: 0px;intensity: 0.5; }
    content := Rectangle {
        x: (parent.width - self.width) / 2; y: 20px; width: Math.min(1600px, parent.width) - 40px; height: parent.height - 40px;
        operation := SmallLabel { x: 0px; y: 0px;height: 15px; text: "ИГРА"; letter-spacing: 2.8px; }
        Rectangle { x: operation.preferred-width + 12px; y: 7.5px; width: parent.width - self.x; height: 1px; background: Tokens.secondary; }
        summary := Rectangle { x: 0px;
            y: Tokens.line-height(15px, 1phx) + 12px; height: Math.max(Tokens.line-height(42.5px, 1phx) + 6px + 2 * Tokens.line-height(21.125px, 1phx), server.height);
            HorizontalLayout { x: 0px; y: 0px;
                width: parent.width - 364px; height: Tokens.line-height(42.5px, 1phx); alignment: start; spacing: 12px;
                Text { text: root.workshop ? "Мастерская карт" : "BLOCKFIELD"; color: #fafafa; font-size: 34px; font-weight: Tokens.weight-medium; letter-spacing: 1.36px; vertical-alignment: center; }
                SmallLabel { text: "Minecraft 1.21.1 · Fabric"; letter-spacing: 1.8px; vertical-alignment: bottom; height: 35px; }
            }
            Text { x: 0px;
                y: Tokens.line-height(42.5px, 1phx) + 6px; width: Math.min(620px, parent.width - 364px); height: 2 * Tokens.line-height(21.125px, 1phx);
                text: root.workshop ? "Строительство карт с отдельными настройками и папкой игры." : "Командные бои с захватом точек. Выбирайте доступный класс и снаряжение, занимайте позиции и сохраняйте билеты своей команды.";
                // Inter hhea ascent/descent are 1984/-494 at 2048 UPEM; avoid self font-metric binding recursion.
                color: Tokens.secondary-foreground; font-size: 13px; wrap: word-wrap; line-height-factor: Tokens.line-height(21.125px, 1phx) / 13px * 2048 / 2478;
            }
            server := Rectangle { y: 0px;
                x: parent.width - 340px; width: 340px; height: 40px + 2phx + 2 * Tokens.line-height(15px, 1phx) + Tokens.line-height(19.5px, 1phx); background: Tokens.chrome; border-width: 1phx; border-color: Tokens.border;
                SmallLabel { x: 16px + 1phx; y: 12px + 1phx; height: Tokens.line-height(15px, 1phx); text: "СЕРВЕР"; }
                HorizontalLayout {
                    x: parent.width - self.preferred-width - 16px - 1phx; y: 12px + 1phx; width: self.preferred-width; height: Tokens.line-height(15px, 1phx); spacing: 6px;
                    Rectangle { width: 6px; height: 15px;
                        StatusDot { x: 0px; y: 4.5px; pulse: root.data.online && MainMotion.enabled; tint: root.data.updating ? Tokens.primary : root.data.online ? Tokens.success : #e36a5d; }
                    }
                    SmallLabel { text: root.data.maintenance != "" ? "ТЕХРАБОТЫ" : root.data.updating ? "ОБНОВЛЯЕТСЯ" : root.data.online ? "ОНЛАЙН" : "НЕДОСТУПЕН"; color: root.data.updating ? Tokens.primary : root.data.online ? Tokens.success : #e36a5d; letter-spacing: 1.6px; }
                }
                Image { x: 16px + 1phx; y: 20px + 1phx + Tokens.line-height(15px, 1phx) + (Tokens.line-height(19.5px, 1phx) - 14px) / 2; width: 14px; height: 14px; source: @image-url("../assets/icons/shield-check.svg"); colorize: Tokens.primary; }
                Text { x: 38px + 1phx; y: 20px + 1phx + Tokens.line-height(15px, 1phx); height: Tokens.line-height(19.5px, 1phx); width: parent.width - 54px - 2phx; text: root.workshop ? "Мастерская" : "BLOCKFIELD · ОСНОВНОЙ"; color: Tokens.neutral-100; font-size: 13px; letter-spacing: 2.34px; overflow: elide; }
                SmallLabel { x: 16px + 1phx; y: 28px + 1phx + Tokens.line-height(15px, 1phx) + Tokens.line-height(19.5px, 1phx); height: Tokens.line-height(15px, 1phx); width: parent.width - 32px - 2phx; text: "play.blockfield.pro:25565"; letter-spacing: 0.8px; overflow: elide; }
            }
        }
        play := GlowPanel { x: 0px;
            y: summary.y + summary.height + 16px;
            height: 104px + 2phx + (root.data.can-workshop ? 48px : 0px) + (root.data.profile-error != "" ? 34px : 0px);
            if root.data.can-workshop: Rectangle {
                x: 20px + 1phx; y: 20px + 1phx; width: parent.width - 40px - 2phx; height: 32px;
                profile-label := Text { x: 0px; y: 0px; height: 32px; font-weight: Tokens.weight-medium; text: "Профиль"; color: Tokens.secondary-foreground; font-size: 12px; vertical-alignment: center; }
                profile-select := MainSelect { y: 0px; x: profile-label.preferred-width + 12px; width: 140px; label: "Профиль"; options: ["Игра", "Мастерская"]; selected: root.workshop ? 1 : 0; enabled: !root.data.profile-changing && !root.data.checking && !root.data.launching && !root.game-busy; chosen(index) => { root.workshop = index == 1; root.details-view = 0; root.room-index = 0; root.room-message = ""; root.error-details = false; } }
                Text { y: 0px; x: profile-select.x + profile-select.width + 12px; width: parent.width - self.x; height: 32px; text: root.data.profile-changing ? "Смена профиля…" : root.data.profile-blocked ? "Ожидание смены профиля…" : root.workshop ? "Свои игровые настройки и файлы. Аккаунт общий." : "Основная игровая установка."; color: Tokens.secondary-foreground; font-size: 12px; vertical-alignment: center; }
            }
            if root.data.profile-error != "": Text { x: 20px + 1phx; y: root.data.can-workshop ? 69px : 21px; text: root.data.profile-error; font-size: 12px; color: #c98b8b; }
            Rectangle {
                x: 20px + 1phx; y: 20px + 1phx + (root.data.can-workshop ? 48px : 0px) + (root.data.profile-error != "" ? 34px : 0px); width: parent.width - 40px - 2phx; height: 64px;
                // CSS shadow spread -8px shrinks the shadow caster, not the button.
                Rectangle {
                    x: 8px; y: 8px; width: 214px; height: 48px;
                    drop-shadow-blur: root.disabled ? 0px : 40px;
                    drop-shadow-color: root.disabled ? transparent : Tokens.primary.with-alpha(0.45);
                }
                deploy := ActionArea { x: 0px; y: 0px;
                    width: 230px; height: 64px; label: root.launch-label; enabled: !root.disabled;
                    opacity: root.disabled && root.data.phase != "running" ? 0.5 : 1;
                    animate opacity { duration: MainMotion.enabled ? Tokens.transition : 0ms; easing: Tokens.transition-easing; }
                    background: root.disabled || root.data.phase == "running" ? Tokens.chrome : @linear-gradient(180deg, #2a2116, #11100d);
                    border-width: 1phx;
                    border-color: root.data.phase == "running" ? Tokens.success.with-alpha(0.4) : root.disabled ? Tokens.border : self.hovered ? Tokens.primary : Tokens.primary.with-alpha(0.5);
                    animate border-color { duration: MainMotion.enabled ? Tokens.transition : 0ms; easing: Tokens.transition-easing; }
                    clicked => { if !root.disabled { root.deploy(); } }
                    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; clip: true;
                    if !root.disabled: Rectangle { x: 1phx; y: 1phx; width: parent.width - 2phx; height: parent.height - 2phx; border-width: 1phx; border-color: Tokens.primary.with-alpha(0.1); }
                    for corner in 4: Rectangle {
                        x: Math.mod(corner, 2) == 0 ? 1px : parent.width - 13px; y: corner < 2 ? 1px : parent.height - 13px; width: 12px; height: 12px;
                        Rectangle { y: 0px;x: Math.mod(corner, 2) == 0 ? 0px : 11px; width: 1px; background: root.disabled ? #3a2c1d : Tokens.primary; }
                        Rectangle { x: 0px;y: corner < 2 ? 0px : 11px; height: 1px; background: root.disabled ? #3a2c1d : Tokens.primary; }
                    }
                    disabled-hover := TouchArea { x: 0px; y: 0px; enabled: root.disabled; mouse-cursor: root.data.phase == "running" ? default : not-allowed; }
                    Rectangle { x: 0px; y: 0px; background: (deploy.hovered || disabled-hover.has-hover) ? Tokens.primary.with-alpha(0.1) : transparent; animate background { duration: MainMotion.enabled ? Tokens.transition : 0ms; easing: Tokens.transition-easing; } }
                    HorizontalLayout { x: 0px; y: 0px;
                        alignment: center; spacing: 16px;
                        Rectangle {
                            width: 18px; height: 64px;
                            if root.data.launching && root.data.phase != "running": Spinner { x: 0px; y: 23px; width: 18px; height: 18px; }
                            if !root.data.launching || root.data.phase == "running": Image { x: 0px; y: 23px; width: 18px; height: 18px; source: root.data.phase == "running" ? @image-url("../assets/icons/gamepad-2.svg") : @image-url("../assets/icons/play.svg"); colorize: root.data.phase == "running" ? Tokens.success : root.disabled ? Tokens.faint : Tokens.foreground; }
                        }
                        VerticalLayout { alignment: center; spacing: 4px;
                            Text { text: root.launch-label; color: Tokens.foreground; font-size: 17px; font-weight: Tokens.weight-medium; letter-spacing: 4.42px; height: 17px; }
                            Text { text: root.launch-sub; color: Tokens.secondary-foreground; font-size: 9px; font-weight: Tokens.weight-medium; letter-spacing: 1.44px; height: 9px; }
                        }
                    }
                    }
                }
                Rectangle {
                    x: 254px; y: 13px; width: 390px; height: 38px;
                    for stat[index] in ["МОДПАК", "ВХОД"]: Rectangle { x: 0px;
                        y: index * 23px; height: 15px;
                        SmallLabel { x: 0px; y: 0px;text: stat; width: 80px; height: 15px; font-size: 9px; letter-spacing: 1.44px; }
                        SmallLabel { y: 0px;x: 92px; text: "▸ " + (index == 0 ? root.state-text : "ПО АККАУНТУ"); color: index == 0 ? root.state-color : Tokens.success; height: 15px; letter-spacing: 1.6px; }
                    }
                }
                HorizontalLayout { y: 0px;
                    x: parent.width - self.preferred-width; width: self.preferred-width; height: 64px; spacing: 16px; alignment: end;
                    Metric { label: "ИГРОКИ"; value: root.data.players; sub: "/ 100"; icon: @image-url("../assets/icons/users.svg"); }
                    Rectangle { width: 1px; height: 64px; Rectangle { x: 0px; y: 12px; width: 1px; height: 40px; background: Tokens.secondary; } }
                    Metric { label: "ПИНГ"; value: root.data.ping; sub: "MS"; icon: @image-url("../assets/icons/activity.svg"); }
                    Rectangle { width: 1px; height: 64px; Rectangle { x: 0px; y: 12px; width: 1px; height: 40px; background: Tokens.secondary; } }
                    Metric { tooltip: root.data.location; label: "РЕГИОН"; value: root.data.region; icon: @image-url("../assets/icons/wifi.svg"); }
                }
            }
        }
        if root.banner: Rectangle { x: 0px;
            y: play.y + play.height + 8px; height: 18px;
            Text { x: 0px; y: 0px;text: root.room-message != "" ? root.room-message : "Есть приглашение в игру. Для входа выберите профиль «Игра»."; color: Tokens.secondary-foreground; font-size: 12px; }
            ActionArea { y: 0px;x: parent.width - 60px; width: 60px; height: 18px; label: "Закрыть"; clicked => { root.room-message = ""; } Text { x: 0px; y: 0px;text: "Закрыть"; color: Tokens.secondary-foreground; font-size: 12px; } }
        }
        details := Rectangle { x: 0px;
            y: play.y + play.height + 16px + (root.banner ? 26px : 0px); height: parent.height - self.y;
            border-width: 1phx; border-color: Tokens.border; background: Tokens.secondary;
            left := Rectangle {
                x: 1phx; y: 1phx; width: (parent.width - 2phx - 1px) * 1.6 / 2.6; height: parent.height - 2phx; background: Tokens.chrome;
                tabs := Rectangle {
                    x: 16px; y: 16px; width: parent.width - 32px; height: 32px + 1phx;
                    Rectangle { x: 0px;y: 32px; height: 1phx; background: Tokens.border; }
                    HorizontalLayout { x: 0px; y: 0px;alignment: start; spacing: 16px;
                        for tab[index] in [(root.workshop ? "Мастерская" : "Матчи") + (root.data.rooms-available ? " · " + root.rooms.length : ""), "Брифинг"]: ActionArea {
                            label: tab; width: tab-text.preferred-width; height: 32px;
                            clicked => { root.details-view = index; }
                            tab-text := Text { x: 0px; y: 0px;text: tab; font-size: 12px; font-weight: Tokens.weight-medium; color: root.details-view == index || parent.hovered ? Tokens.foreground : Tokens.muted-foreground; height: 32px; vertical-alignment: center; animate color { duration: MainMotion.enabled ? Tokens.transition : 0ms; easing: Tokens.transition-easing; } }
                            Rectangle { x: 0px;y: 32px - 1phx; height: 1phx; background: root.details-view == index ? Tokens.primary : transparent; }
                        }
                    }
                }
                body := Rectangle {
                    x: 16px; y: 56px + 1phx; width: parent.width - 32px; height: parent.height - 72px - 1phx;
                    if root.details-view == 0 && root.workshop: Text { x: 0px; y: 0px; width: parent.width; text: "Вход доступен участникам мастерской во время открытой сессии. Адрес подключения задаётся в настройках этого профиля."; color: Tokens.secondary-foreground; font-size: 13px; wrap: word-wrap; line-height-factor: 1.625 * 2048 / 2478; }
                    if root.details-view == 0 && !root.workshop: Rectangle { x: 0px; y: 0px;
                        if root.rooms.length > 0: Rectangle { x: 0px; y: 0px;
                            MainSelect { x: 0px; y: 0px;width: parent.width - join-button.width - 12px; label: "Выбрать матч"; options: root.room-names; selected <=> root.room-index; }
                            join-button := MainButton { y: 0px;x: parent.width - self.width; label: root.room.join + ": " + root.room.name; text: root.room.join; selected: true; enabled: !root.room-disabled && !root.data.updating && root.room.joinable; clicked => { if self.enabled { root.join(root.room.id); } } }
                            Text { x: 0px;y: 40px; height: 18px; width: parent.width; text: root.room.description; color: Tokens.secondary-foreground; font-size: 12px; overflow: elide; }
                            HorizontalLayout { x: 0px;y: 66px; height: 18px; alignment: start; spacing: 20px;
                                Text { text: "Игроков: " + root.room.players; color: Tokens.secondary-foreground; font-size: 12px; }
                                Text { text: root.room.ready; color: Tokens.secondary-foreground; font-size: 12px; }
                            }
                        }
                        if root.rooms.length == 0: Text { x: 0px; y: 0px;
                            width: parent.width; text: root.data.maintenance != "" ? "Идут технические работы: " + root.data.maintenance + " Матчи откроются после завершения работ." : root.data.updating ? "Игровой сервер обновляется — лобби открыто. Нажмите «Играть» — вас перенесут в игру, когда сервер запустится." : !root.data.rooms-available ? "Список матчей недоступен. Повторим запрос автоматически." : "Сейчас матчей нет. Нажмите «Играть» и выберите режим в хабе: Casual или Рейтинг.";
                            color: Tokens.secondary-foreground; font-size: 12px; wrap: word-wrap; line-height-factor: 1.625 * 2048 / 2478;
                        }
                        Rectangle { x: 0px;y: parent.height - 41px; height: 1px; background: Tokens.border; }
                        if root.rooms.length > 0: HorizontalLayout { x: 0px;
                            y: parent.height - 32px; height: 32px; width: self.preferred-width; alignment: start; spacing: 8px;
                            MainButton { label: "Предыдущий матч"; text: ""; icon: @image-url("../assets/icons/chevron-left.svg"); enabled: root.room-index > 0; clicked => { if self.enabled { root.room-index -= 1; } } }
                            Text { text: (root.room-index + 1) + " / " + root.rooms.length; color: Tokens.secondary-foreground; font-size: 12px; vertical-alignment: center; }
                            MainButton { label: "Следующий матч"; text: ""; icon: @image-url("../assets/icons/chevron-right.svg"); enabled: root.room-index + 1 < root.rooms.length; clicked => { if self.enabled { root.room-index += 1; } } }
                        }
                        MainButton { x: parent.width - self.width; y: parent.height - 32px; label: "Войти в лобби"; enabled: !root.room-disabled; clicked => { if self.enabled { root.join("lobby"); } } }
                    }
                    if root.details-view == 1: GridLayout { x: 0px; y: 0px;
                        width: parent.width; height: self.preferred-height;
                        spacing-horizontal: 32px; spacing-vertical: 20px;
                        Row {
                            Feature { icon: @image-url("../assets/icons/flag.svg"); title: "ЗАХВАТ ТОЧЕК"; description: "Сражайтесь за контроль точек и сохраняйте билеты своей команды."; }
                            Feature { icon: @image-url("../assets/icons/swords.svg"); title: "КЛАССЫ"; description: "Штурмовик и марксман. Доступность инженера, снайпера и оператора FPV зависит от настроек и числа игроков."; }
                        }
                        Row {
                            Feature { icon: @image-url("../assets/icons/crosshair.svg"); title: "СНАРЯЖЕНИЕ"; description: "Выбирайте комплект оружия из вариантов, доступных вашему классу."; }
                            Feature { icon: @image-url("../assets/icons/gamepad-2.svg"); title: "ИГРОВОЕ МЕНЮ"; description: "Выбирайте режим, класс и точку высадки через планшет в игре."; }
                        }
                    }
                }
            }
            Rectangle {
                x: left.x + left.width + 1px; y: 1phx; width: parent.width - self.x - 1phx; height: parent.height - 2phx; background: Tokens.chrome;
                Rectangle {
                    x: 20px; y: 20px; width: parent.width - 40px; height: parent.height - 40px;
                    Rectangle { x: 0px;y: 4.5px; width: 6px; height: 6px; background: Tokens.primary; }
                    header := Text { y: 0px;x: 18px; height: Tokens.line-height(15px, 1phx); text: "СТАТУС МОДПАКА"; font-size: 10px; letter-spacing: 1.8px; color: Tokens.foreground; }
                    package-code := SmallLabel { y: 0px;x: parent.width - self.preferred-width; height: 15px; text: "PKG-LIVE"; font-size: 9px; letter-spacing: 2.52px; color: Tokens.faint; }
                    Rectangle { x: header.x + header.preferred-width + 12px; y: 7.5px; width: package-code.x - 12px - self.x; height: 1px; background: Tokens.secondary; }
                    VerticalLayout { x: 0px;
                        y: Tokens.line-height(15px, 1phx) + 12px; height: self.preferred-height; spacing: 8px;
                        PackageRow { label: "УСТАНОВЛЕН"; value: root.data.installed; }
                        PackageRow { label: "ПОСЛЕДНИЙ"; value: root.data.latest; highlight: root.data.needs-update; }
                        PackageRow { label: "РАЗМЕР"; value: root.data.size; }
                        PackageRow { label: "СОСТОЯНИЕ"; last: root.data.check-error == "" && root.data.launch-error == ""; value: root.state-text; highlight: root.data.needs-setup; }
                    }
                    if root.data.check-error != "" || root.data.launch-error != "": Rectangle { x: 0px;
                        y: Tokens.line-height(15px, 1phx) + 12px + 4 * (Tokens.line-height(16.5px, 1phx) + 16px + 1phx); height: parent.height - self.y - 44px;
                        Text { x: 0px; y: 0px;width: parent.width; text: root.data.check-error != "" ? "Не удалось проверить обновление модпака." : "Не удалось запустить игру."; color: #c98b8b; font-size: 11px; wrap: word-wrap; }
                        ActionArea { x: 0px; y: Tokens.line-height(17.875px, 1phx) + 4px; width: disclosure.preferred-width + 11px; height: Tokens.line-height(16.25px, 1phx); label: "Подробности"; clicked => { root.error-details = !root.error-details; }
                            Path { x: 0px; y: 7px; width: 5px; height: 5px; viewbox-width: 7; viewbox-height: 7; fill: Tokens.muted-foreground; commands: root.error-details ? "M 0 0 L 7 0 L 3.5 7 Z" : "M 0 0 L 7 3.5 L 0 7 Z"; }
                            disclosure := SmallLabel { x: 11px; y: 0px; height: parent.height; text: "Подробности"; letter-spacing: 1px; }
                        }
                        if root.error-details: Text { x: 0px;y: Tokens.line-height(17.875px, 1phx) + Tokens.line-height(16.25px, 1phx) + 8px; width: parent.width; text: root.data.check-error != "" ? root.data.check-error : root.data.launch-error; font-family: Tokens.mono; font-size: 10px; color: Tokens.muted-foreground; wrap: word-wrap; }
                    }
                    verify := MainButton { x: 0px;y: parent.height - 32px; width: parent.width; label: root.data.checking ? "ПРОВЕРКА..." : "ПРОВЕРИТЬ ФАЙЛЫ"; icon: @image-url("../assets/icons/refresh-cw.svg"); spinning: root.data.checking; icon-size: 12px; text-size: 10px; tracking: 1.6px; enabled: !root.data.checking && !root.game-busy; clicked => { if self.enabled { root.verify(); } } }
                }
            }
        }
    }
}
