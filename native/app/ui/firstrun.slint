import { Tokens } from "tokens.slint";
import { ActionArea } from "controls.slint";
import { GridBackdrop, TopoBackdrop } from "backdrop.slint";
import { AuthHeader, AuthPathField, FieldRow, FormButton, TextField } from "forms.slint";
import { FormError } from "settings-inputs.slint";

// Native port of src/app/components/FirstRunScreen.tsx: game dir, Java path
// and RAM controls with the same defaults, icons, presets and validation.
component StepButton inherits ActionArea {
    in property <image> icon;
    in property <string> tip;
    label: root.tip;
    width: 36px;
    height: 36px;
    background: root.hovered ? Tokens.secondary : Tokens.chrome;
    border-width: 1px;
    border-color: root.hovered ? Tokens.ring : Tokens.border;
    Image {
        x: (parent.width - 12px) / 2;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        source: root.icon;
        colorize: root.hovered ? Tokens.foreground : Tokens.secondary-foreground;
        accessible-role: none;
    }
}

component RamSlider inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 2;
    in property <int> maximum;
    private property <float> fraction: (root.value - root.minimum) / Math.max(1, root.maximum - root.minimum);
    callback changed(int);
    function set-value(v: int) {
        if v != root.value {
            root.value = Math.max(root.minimum, Math.min(root.maximum, v));
            root.changed(root.value);
        }
    }
    function apply-x(x: length) {
        root.set-value(root.minimum + Math.round((root.maximum - root.minimum) * x / Math.max(1px, bar.width)));
    }
    accessible-role: slider;
    accessible-label: "Выделенная память, ГБ";
    accessible-value: "\{root.value}";
    height: 36px;
    bar := Rectangle {
        x: 0px;
        y: (parent.height - 6px) / 2;
        width: parent.width;
        height: 6px;
        background: Tokens.chrome;
        border-width: 1px;
        border-color: Tokens.border;
        fill := Rectangle {
            x: 1px;
            y: 1px;
            width: (parent.width - 2px) * root.fraction;
            height: parent.height - 2px;
            background: @linear-gradient(90deg, #8a571c, #f5a524);
        }
        Rectangle {
            x: 1px + (parent.width - 2px) * root.fraction - 6px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            background: Tokens.primary;
            border-width: 1px;
            border-color: Tokens.background;
            drop-shadow-blur: 8px;
            drop-shadow-color: #f5a524.with-alpha(0.6);
        }
    }
    touch := TouchArea {
        x: 0px;
        y: 0px;
        mouse-cursor: pointer;
        clicked => { root.apply-x(self.mouse-x); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move && self.pressed {
                root.apply-x(self.mouse-x);
            }
        }
    }
}

component PresetButton inherits ActionArea {
    in property <string> text;
    in property <bool> current;
    label: root.text;
    height: 28px;
    horizontal-stretch: 1;
    background: root.current ? Tokens.primary : Tokens.chrome;
    border-width: 1px;
    border-color: root.current ? Tokens.primary : (root.hovered ? Tokens.ring : Tokens.border);
    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-family: Tokens.mono;
        font-size: 10px;
        letter-spacing: 1.4px;
        color: root.current ? #070604 : (parent.hovered ? Tokens.foreground : Tokens.secondary-foreground);
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

export component FirstRunScreen inherits Rectangle {
    in-out property <string> game-dir;
    in-out property <string> java-path;
    in-out property <int> ram;
    in property <int> maxram;
    in property <[int]> presets;
    in property <bool> saving;
    in property <string> error;
    in property <string> raw-error;
    callback browse-dir();
    callback browse-java();
    callback ram-text-edited(string);
    callback continue();
    background: Tokens.background;
    TopoBackdrop { x: 0px; y: 0px; }
    GridBackdrop { x: 0px; y: 0px; intensity: 0.4; }
    VerticalLayout {
        x: (parent.width - self.width) / 2;
        y: Math.max(24px, (parent.height - self.preferred-height) / 2);
        width: Math.min(640px, parent.width - 32px);
        height: self.preferred-height;
        alignment: center;
        spacing: 16px;
        AuthHeader {
            title: "ПЕРВЫЙ ЗАПУСК";
            hint: "Проверьте параметры игры. Их можно изменить позже в настройках.";
        }
        Rectangle {
            background: Tokens.card;
            border-width: 1px;
            border-color: Tokens.border;
            height: inner.preferred-height + 18px;
            inner := VerticalLayout {
                x: 21px;
                y: 9px;
                width: parent.width - 42px;
                FieldRow {
                    icon: @image-url("../assets/icons/folder.svg");
                    label: "ПАПКА ИГРЫ";
                    hint: "Рекомендуемое значение по умолчанию — можно изменить.";
                    AuthPathField {
                        width: 100%;
                        label: "Папка игры";
                        value <=> root.game-dir;
                        browse => { root.browse-dir(); }
                    }
                }
                FieldRow {
                    icon: @image-url("../assets/icons/coffee.svg");
                    label: "СРЕДА JAVA";
                    hint: "Путь необязателен — лаунчер выберет Java автоматически.";
                    AuthPathField {
                        width: 100%;
                        label: "Java";
                        placeholder: "Автоматически";
                        value <=> root.java-path;
                        browse => { root.browse-java(); }
                    }
                }
                ram-row := FieldRow {
                    icon: @image-url("../assets/icons/cpu.svg");
                    label: "ВЫДЕЛЕНИЕ RAM";
                    hint: "\{root.ram} ГБ выделено · по умолчанию 4 ГБ";
                    content-height: root.maxram < 2 ? 40px : 103px;
                    last: true;
                    if root.maxram < 2: Text {
                        x: 0px;
                        width: 100%;
                        text: "Недостаточно памяти: для игры нужно выделить минимум 2 ГБ.";
                        font-size: 11px;
                        color: #c98b8b;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.maxram >= 2: Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 103px;
                        StepButton {
                            x: 0px;
                            y: 0px;
                            icon: @image-url("../assets/icons/minus.svg");
                            tip: "Уменьшить память";
                            enabled: root.ram > 2;
                            clicked => { root.ram -= 1; }
                        }
                        RamSlider {
                            x: 48px;
                            y: 0px;
                            width: parent.width - 188px;
                            value <=> root.ram;
                            minimum: 2;
                            maximum: root.maxram;
                        }
                        StepButton {
                            x: parent.width - 128px;
                            y: 0px;
                            icon: @image-url("../assets/icons/plus.svg");
                            tip: "Увеличить память";
                            enabled: root.ram < root.maxram;
                            clicked => { root.ram += 1; }
                        }
                        ram-number := TextField {
                            x: parent.width - 70px;
                            y: 0px;
                            width: 48px;
                            field-height: 36px;
                            field-label: "Память, ГБ";
                            numeric: true;
                            text-color: Tokens.foreground;
                            value: "\{root.ram}";
                            edited => { root.ram-text-edited(ram-number.value); }
                        }
                        Text {
                            x: parent.width - 17px;
                            y: 0px;
                            height: 36px;
                            text: "GB";
                            font-size: 10px;
                            letter-spacing: 1.8px;
                            color: Tokens.muted-foreground;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            x: 0px;
                            y: 48px;
                            width: parent.width;
                            height: 28px;
                            spacing: 4px;
                            for preset in root.presets: PresetButton {
                                text: "\{preset}G";
                                current: preset == root.ram;
                                clicked => { root.ram = preset; }
                            }
                        }
                        Text {
                            x: 0px;
                            y: 88px;
                            width: parent.width;
                            height: 15px;
                            text: "Доступно для игры: 2–\{root.maxram} ГБ";
                            font-size: 10px;
                            color: #a89373;
                            horizontal-alignment: right;
                        }
                    }
                }
            }
        }
        if root.error != "": FormError {
            width: 100%;
            message: root.error;
            raw: root.raw-error;
        }
        HorizontalLayout {
            alignment: end;
            FormButton {
                text: "ПРОДОЛЖИТЬ";
                icon: @image-url("../assets/icons/arrow-right.svg");
                busy: root.saving;
                enabled: !root.saving && root.maxram >= 2;
                clicked => { root.continue(); }
            }
        }
    }
}
