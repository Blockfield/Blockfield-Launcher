import { Tokens } from "tokens.slint";
import { ActionArea } from "controls.slint";
import { SettingsForm } from "settings-model.slint";
import { Spinner } from "main-controls.slint";
import { MainMotion } from "main-controls.slint";

export component FormInput inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> multiline;
    in property <bool> numeric;
    in-out property <string> value;
    out property <bool> has-focus: input.has-focus;
    callback edited();
    callback accepted();
    callback blurred();
    forward-focus: input;
    height: root.multiline ? 80px : 40px;
    background: Tokens.chrome;
    border-width: 1phx;
    border-color: input.has-focus ? Tokens.primary.with-alpha(0.6) : Tokens.border;
    animate border-color { duration: MainMotion.enabled ? 150ms : 0ms; }
    Text { x: 12px; y: root.multiline ? 12px : 0px; width: parent.width - 24px; height: root.multiline ? 18px : parent.height;
        visible: root.value == "";
        text: root.placeholder; font-family: Tokens.mono; font-size: 12px; color: #a89373;
        vertical-alignment: root.multiline ? top : center;
    }
    input := TextInput {
        x: root.numeric ? 8px : 12px; y: root.multiline ? 12px : 0px;
        width: parent.width - (root.numeric ? 16px : 24px); height: parent.height - (root.multiline ? 24px : 0px);
        text <=> root.value; single-line: !root.multiline; wrap: root.multiline ? word-wrap : no-wrap;
        input-type: root.password ? InputType.password : InputType.text;
        font-family: Tokens.mono; font-size: 12px; color: Tokens.neutral-200;
        horizontal-alignment: root.numeric ? right : left;
        vertical-alignment: root.multiline ? top : center;
        selection-background-color: Tokens.primary; selection-foreground-color: Tokens.background;
        accessible-label: root.label;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
        changed has-focus => { if !self.has-focus { root.blurred(); } }
    }
}

export component FormButton inherits ActionArea {
    in property <string> text;
    in property <image> icon;
    in property <length> horizontal-padding: 12px;
    in property <bool> primary;
    in property <bool> busy;
    in property <bool> footer;
    in property <bool> selected;
    in property <bool> compact;
    label: root.text;
    height: root.compact ? 28px : 40px;
    width: caption.preferred-width + 2 * root.horizontal-padding + (root.icon.width > 0 ? 20px : 0px);
    opacity: root.enabled ? 1 : 0.5;
    background: root.selected ? Tokens.primary : root.primary ? @linear-gradient(180deg, #2a2116, #11100d) : Tokens.chrome;
    border-width: 1phx;
    border-color: root.selected ? Tokens.primary : root.hovered ? Tokens.ring : root.primary ? Tokens.primary.with-alpha(0.4) : Tokens.border;
    animate border-color { duration: MainMotion.enabled ? 150ms : 0ms; }
    if root.busy: Spinner { x: root.horizontal-padding; y: (parent.height - 13px) / 2; width: 13px; height: 13px; }
    if root.icon.width > 0 && !root.busy: Image { x: root.horizontal-padding; y: (parent.height - 12px) / 2; width: 12px; height: 12px; source: root.icon; colorize: Tokens.secondary-foreground; }
    caption := Text { x: root.compact ? 0px : root.horizontal-padding + (root.icon.width > 0 ? 20px : 0px); y: 0px; width: root.compact ? parent.width : self.preferred-width; horizontal-alignment: root.compact ? center : left; height: parent.height; text: root.text;
        font-family: root.compact ? Tokens.mono : Tokens.sans;
        font-size: root.footer ? 11px : 10px; font-weight: 600; letter-spacing: root.footer ? 1.98px : 1.4px;
        color: root.selected ? Tokens.background : root.primary || root.hovered ? Tokens.foreground : Tokens.secondary-foreground;
        vertical-alignment: center;
    }
}

export component EditablePath inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    callback browse();
    height: 40px;
    FormInput { x: 0px; width: parent.width - 66px; value <=> root.value; label: root.label; placeholder: root.placeholder; edited => { SettingsForm.edited(); } }
    FormButton { x: parent.width - self.width; width: 67px; text: "ОБЗОР"; clicked => { root.browse(); } }
}

export component FormToggle inherits ActionArea {
    in property <bool> on;
    callback toggled(bool);
    width: 56px; height: 28px;
    accessible-role: switch; accessible-checked: root.on;
    clicked => { root.toggled(!root.on); SettingsForm.edited(); }
    background: root.on ? Tokens.border : Tokens.chrome;
    border-width: 1phx; border-color: root.on ? Tokens.primary.with-alpha(0.6) : Tokens.border;
    Rectangle {
        x: root.on ? 31px : 3px; y: 4px; width: 20px; height: 20px;
        background: root.on ? Tokens.primary : #3a2c1d;
        animate x { duration: MainMotion.enabled ? 150ms : 0ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }
    Text { y: 35px; width: 56px; height: 12px; text: root.on ? "ВКЛ" : "ВЫКЛ"; font-size: 9px; letter-spacing: 1.44px;
        color: root.on ? Tokens.primary : Tokens.muted-foreground; horizontal-alignment: right;
    }
}

export component FormError inherits Rectangle {
    in property <string> message;
    in property <string> raw;
    private property <bool> expanded;
    height: message-text.preferred-height + (root.raw != "" ? 19px : 0px) + (root.expanded ? raw-text.preferred-height + 4px : 0px);
    message-text := Text { x: 0px; y: 0px; width: parent.width; text: root.message; font-size: 11px; color: #c98b8b; wrap: word-wrap; }
    ActionArea {
        y: message-text.preferred-height + 4px; height: 15px; width: parent.width;
        visible: root.raw != ""; label: "Подробности";
        clicked => { root.expanded = !root.expanded; }
        Image { y: 2px; width: 10px; height: 10px; source: @image-url("../assets/icons/chevron-right.svg"); colorize: Tokens.muted-foreground; transform-rotation: root.expanded ? 90deg : 0deg; }
        Text { x: 13px; height: 15px; text: "Подробности"; font-size: 10px; letter-spacing: 1px; color: Tokens.muted-foreground; }
    }
    raw-text := Text { y: message-text.preferred-height + 23px; width: parent.width; visible: root.expanded;
        text: root.raw; font-size: 10px; font-family: Tokens.mono; color: Tokens.muted-foreground; wrap: word-wrap;
    }
}
