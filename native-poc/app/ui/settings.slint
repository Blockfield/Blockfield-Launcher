import { Tokens } from "tokens.slint";
import { ActionArea } from "controls.slint";
import { GridBackdrop, TopoBackdrop } from "backdrop.slint";
import { SkinPreview } from "../../skin3d/src/slint_preview.slint";

component SettingsTabButton inherits Rectangle {
    in property <string> label;
    in property <bool> current;
    callback chosen();
    height: 44px;
    background: root.current ? Tokens.secondary : (press-touch.has-hover ? Tokens.card : transparent);
    tab-text := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - 2px;
        text: root.label;
        font-size: 11px;
        letter-spacing: 0.88px;
        color: root.current ? Tokens.foreground : (press-touch.has-hover ? Tokens.foreground : Tokens.secondary-foreground);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.current: Rectangle { x: 0px; y: parent.height - 2px; width: parent.width; height: 2px; background: Tokens.primary; }
    press-touch := TouchArea {
        x: 0px;
        y: 0px;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.chosen(); }
    }
    keys := FocusScope {
        x: 0px;
        y: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.chosen();
                return accept;
            }
            return reject;
        }
    }
    if keys.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: root.width - 4px;
        height: root.height - 4px;
        border-width: 2px;
        border-color: Tokens.primary;
    }
}

component SettingRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> hint;
    // Fixed heights keep the dashed separators aligned without text measurement loops.
    in property <length> row-height;
    height: root.row-height;
    Rectangle {
        x: 0px;
        y: 8px;
        width: 28px;
        height: 28px;
        background: Tokens.chrome;
        border-width: 1px;
        border-color: Tokens.border;
        Image {
            x: 7px;
            y: 7px;
            width: 14px;
            height: 14px;
            source: root.icon;
            colorize: Tokens.primary;
        }
    }
    Text {
        x: 40px;
        y: 8px;
        width: 220px;
        height: 15px;
        text: root.label;
        font-size: 11px;
        letter-spacing: 1.32px;
        color: Tokens.neutral-100;
        vertical-alignment: center;
    }
    Text {
        x: 40px;
        y: 25px;
        width: 220px;
        height: parent.height - 33px;
        text: root.hint;
        font-size: 11px;
        color: Tokens.muted-foreground;
        wrap: word-wrap;
    }
    Rectangle {
        x: 284px;
        y: 0px;
        width: 654px;
        height: parent.height;
        @children
    }
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Tokens.secondary; }
}

component PathField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback browse();
    height: 40px;
    clip: true;
    background: Tokens.chrome;
    border-width: 1px;
    border-color: Tokens.border;
    field-text := Text {
        x: 12px;
        y: 0px;
        width: parent.width - 86px;
        height: parent.height;
        text: root.value;
        font-family: Tokens.mono;
        font-size: 12px;
        color: Tokens.neutral-200;
        vertical-alignment: center;
        overflow: elide;
    }
    browse-button := ActionArea {
        x: 580px;
        y: 0px;
        width: 74px;
        height: parent.height;
        label: "ОБЗОР";
        background: Tokens.card;
        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Tokens.border; }
        browse-label := Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: "ОБЗОР";
            font-size: 10px;
            letter-spacing: 1.4px;
            color: parent.hovered ? Tokens.foreground : Tokens.secondary-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        clicked => { root.browse(); }
    }
    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width - 74px;
        mouse-cursor: text;
        clicked => { root.browse(); }
    }
}

component SettingsToggle inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    in property <string> on-label;
    in property <string> off-label;
    callback toggled(bool);
    width: 64px;
    height: 52px;
    track := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
    Rectangle {
        x: 0px;
        y: 0px;
        width: 56px;
        height: 28px;
        background: root.on ? Tokens.border : Tokens.chrome;
        border-width: 1px;
        border-color: root.on ? Tokens.primary.with-alpha(0.6) : Tokens.border;
        Rectangle {
            x: root.on ? 32px : 2px;
            y: 3px;
            width: 22px;
            height: 22px;
            background: root.on ? Tokens.primary : #3a2c1d;
            animate x { duration: 150ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
        }
    }
    Text {
        x: 0px;
        y: 32px;
        width: 56px;
        height: 12px;
        text: root.on ? root.on-label : root.off-label;
        font-size: 9px;
        letter-spacing: 1.44px;
        color: root.on ? Tokens.primary : Tokens.muted-foreground;
        horizontal-alignment: right;
    }
}

component SettingsButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    width: measure.preferred-width + (root.icon.width > 0 ? 34px : 0px) + 48px;
    opacity: root.enabled ? 1 : 0.5;
    measure := Text {
        text: root.text;
        font-size: 11px;
        letter-spacing: 1.98px;
        opacity: 0;
    }
    background: root.primary ? @linear-gradient(180deg, #2a2116, #11100d) : Tokens.card;
    border-width: 1px;
    border-color: root.primary ? (touch.has-hover ? Tokens.primary : Tokens.primary.with-alpha(0.4)) : (touch.has-hover ? Tokens.ring : Tokens.border);
    touch := TouchArea {
        x: 0px;
        y: 0px;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.icon.width > 0: Image {
        x: 24px;
        y: 13.5px;
        width: 13px;
        height: 13px;
        source: root.icon;
        colorize: Tokens.foreground;
    }
    caption := Text {
        x: root.icon.width > 0 ? 45px : 0px;
        y: 0px;
        width: parent.width - (root.icon.width > 0 ? 45px : 0px) - 24px;
        height: parent.height;
        text: root.text;
        font-size: 11px;
        letter-spacing: 1.98px;
        color: root.enabled && touch.has-hover ? Tokens.foreground : Tokens.secondary-foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SettingsScreen inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> tab: 3;
    in property <string> title;
    in property <string> subtitle;
    in property <string> skin-path;
    in property <string> cape-path;
    in-out property <bool> slim: false;
    in property <image> skin-frame;
    in property <string> skin-error;
    in property <string> caption;
    in property <bool> dirty: false;
    callback browse-skin();
    callback browse-cape();
    callback upload();
    callback toggle-slim(bool);
    callback reset();
    callback save();
    callback tab-changed(int);
    callback drag-state(bool);
    callback drag-by(float, float);
    background: Tokens.background;
    TopoBackdrop { x: 0px; y: 0px; }
    GridBackdrop { x: 0px; y: 0px; intensity: 0.4; }
    content := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 20px;
        width: Math.min(1600px, parent.width) - 40px;
        height: parent.height - 40px;
        Text {
            x: 0px;
            y: 0px;
            height: 26px;
            text: root.title;
            font-size: 26px;
            letter-spacing: 1.56px;
            color: Tokens.neutral-100;
            vertical-alignment: center;
        }
        Text {
            x: title-text.preferred-width + 12px;
            y: 0px;
            height: 26px;
            text: root.subtitle;
            font-size: 10px;
            letter-spacing: 1.8px;
            color: Tokens.muted-foreground;
            vertical-alignment: bottom;
        }
        title-text := Text {
            x: 0px;
            y: 0px;
            height: 26px;
            text: root.title;
            font-size: 26px;
            color: transparent;
        }
        panel := Rectangle {
            x: 0px;
            y: 42px;
            width: parent.width;
            height: parent.height - self.y;
            background: Tokens.card;
            border-width: 1px;
            border-color: Tokens.border;
            tabbar := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 44px;
                background: Tokens.chrome;
                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Tokens.border; }
                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    alignment: start;
                    spacing: 0px;
                    for entry[index] in root.tabs: SettingsTabButton {
                        width: tabbar.width / root.tabs.length;
                        label: entry;
                        current: root.tab == index;
                        chosen => {
                            root.tab = index;
                            root.tab-changed(index);
                        }
                    }
                }
            }
            body := Rectangle {
                x: 0px;
                y: 44px;
                width: parent.width;
                height: parent.height - 44px - 64px;
                clip: true;
                if root.tab == 3: skin-content := HorizontalLayout {
                    x: 20px;
                    y: 8px;
                    width: parent.width - 40px;
                    height: parent.height - 16px;
                    spacing: 24px;
                    alignment: start;
                    form := Rectangle {
                        width: parent.width - 262px; // 238px panel + 24px spacing
                        height: parent.height;
                        SettingRow {
                            y: 0px;
                            width: 938px;
                            icon: @image-url("../assets/icons/shirt.svg");
                            label: "СКИН";
                            hint: "PNG 64×64. Без загрузки на сервере остаётся скин лицензионного аккаунта с таким ником.";
                            row-height: 100px;
                            PathField {
                                x: 0px;
                                y: 8px;
                                width: parent.width;
                                label: "СКИН";
                                value: root.skin-path;
                                browse => { root.browse-skin(); }
                            }
                        }
                        SettingRow {
                            y: 100px;
                            width: 938px;
                            icon: @image-url("../assets/icons/shirt.svg");
                            label: "ПЛАЩ";
                            hint: "PNG 64×32. Необязательно.";
                            row-height: 76px;
                            PathField {
                                x: 0px;
                                y: 8px;
                                width: parent.width;
                                label: "ПЛАЩ";
                                value: root.cape-path;
                                browse => { root.browse-cape(); }
                            }
                        }
                        SettingRow {
                            y: 176px;
                            width: 938px;
                            icon: @image-url("../assets/icons/user-round.svg");
                            label: "ТОНКИЕ РУКИ";
                            hint: "Модель Alex (3px) вместо Steve (4px).";
                            row-height: 68px;
                            SettingsToggle {
                                x: 0px;
                                y: 8px;
                                label: "ТОНКИЕ РУКИ";
                                on: root.slim;
                                on-label: "ВКЛ";
                                off-label: "ВЫКЛ";
                                toggled(value) => { root.toggle-slim(value); }
                            }
                        }
                        upload-row := Rectangle {
                            y: 244px;
                            width: 938px;
                            height: 56px;
                            SettingsButton {
                                x: parent.width - self.width;
                                y: 8px;
                                text: "ЗАГРУЗИТЬ";
                                icon: @image-url("../assets/icons/upload.svg");
                                primary: true;
                                enabled: root.skin-path != "" || root.cape-path != "";
                                clicked => { root.upload(); }
                            }
                        }
                    }
                    preview-panel := Rectangle {
                        width: 238px;
                        height: 344px;
                        background: #0b0906;
                        border-width: 1px;
                        border-color: Tokens.border;
                        SkinPreview {
                            x: 9px;
                            y: 9px;
                            frame: root.skin-frame;
                            drag-state(active) => { root.drag-state(active); }
                            drag-by(dx, dy) => { root.drag-by(dx, dy); }
                            accessible-role: image;
                            accessible-label: "Анимированный скин Minecraft; вращайте перетаскиванием";
                        }
                        Text {
                            x: 9px;
                            y: 318px;
                            width: 220px;
                            height: 14px;
                            text: root.caption;
                            font-size: 10px;
                            letter-spacing: 1.8px;
                            color: Tokens.muted-foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if root.skin-error != "": Text {
                            x: 9px;
                            y: 332px;
                            width: 220px;
                            height: 12px;
                            text: root.skin-error;
                            font-size: 10px;
                            color: #c98b8b;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
            actions := Rectangle {
                x: 0px;
                y: parent.height - 64px;
                width: parent.width;
                height: 64px;
                background: Tokens.chrome;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: #18130d; }
                HorizontalLayout {
                    x: parent.width - self.preferred-width - 20px;
                    y: 12px;
                    height: 40px;
                    spacing: 8px;
                    alignment: start;
                    SettingsButton {
                        text: "СБРОС";
                        clicked => { root.reset(); }
                    }
                    SettingsButton {
                        text: "СОХРАНИТЬ";
                        icon: @image-url("../assets/icons/save.svg");
                        enabled: root.dirty;
                        clicked => { root.save(); }
                    }
                }
            }
        }
    }
    changed tab => { root.tab-changed(root.tab); }
}
