import { Tokens } from "tokens.slint";
import { ActionArea } from "controls.slint";
import { Spinner } from "main-controls.slint";

// Shared auth-screen bits (login + firstrun). Same dark-panel look as the
// Tauri LoginScreen/FirstRunScreen: 640px column, card panel, mono inputs.
export component AuthHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: 8px;
    Text {
        text: root.title;
        font-size: 26px;
        font-weight: Tokens.weight-medium;
        letter-spacing: 1.56px;
        color: #fafafa;
        vertical-alignment: center;
    }
    Text {
        text: root.hint;
        font-size: 11px;
        letter-spacing: 1.1px;
        color: Tokens.muted-foreground;
        wrap: word-wrap;
    }
}

// Two-column row matching Tauri Setting (28px icon box + 12px gap + 220px
// label/wrapping-hint block + 24px gap = 284px, content fills the rest).
export component FieldRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> hint;
    in property <length> content-height: 40px;
    in property <bool> last: false;
    private property <length> edge: Math.floor(1px / 1phx) * 1phx;
    private property <length> label-stack-height: 20px + hint-text.preferred-height;
    private property <length> body-height: Math.max(root.content-height, root.label-stack-height);
    height: root.body-height + 24px + (root.last ? 0px : root.edge);
    Rectangle {
        x: 0px;
        y: 14px;
        width: 28px;
        height: 28px;
        background: Tokens.chrome;
        border-width: root.edge;
        border-color: Tokens.border;
        if root.icon.width > 0: Image {
            x: 7px;
            y: 7px;
            width: 14px;
            height: 14px;
            source: root.icon;
            colorize: Tokens.primary;
            accessible-role: none;
        }
    }
    Text {
        x: 40px;
        y: 12px;
        width: 220px;
        height: 16px;
        text: root.label;
        font-size: 11px;
        letter-spacing: 1.32px;
        color: Tokens.neutral-100;
        vertical-alignment: center;
    }
    hint-text := Text {
        x: 40px;
        y: 32px;
        width: 220px;
        text: root.hint;
        font-size: 11px;
        color: Tokens.muted-foreground;
        wrap: word-wrap;
    }
    Rectangle {
        x: 284px;
        y: 12px + (root.body-height - root.content-height) / 2;
        width: parent.width - 284px;
        height: root.content-height;
        @children
    }
    for dash in (root.last ? 0 : Math.ceil(self.width / 6px)): Rectangle {
        x: dash * 6px;
        y: parent.height - root.edge;
        width: Math.min(3px, parent.width - self.x);
        height: root.edge;
        background: Tokens.secondary;
    }
}

// Dark mono input matching the Tauri login/firstrun fields. Raw TextInput keeps
// the house style (std LineEdit paints the OS light theme instead).
export component TextField inherits Rectangle {
    in property <string> field-label;
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> invalid;
    in property <bool> numeric: false;
    in property <bool> auto-focus: false;
    in property <int> focus-trigger: 0;
    in property <color> text-color: Tokens.neutral-200;
    in property <color> placeholder-color: #a89373;
    in property <length> field-height: 40px;
    out property <bool> has-focus: input.has-focus;
    private property <length> edge: Math.floor(1px / 1phx) * 1phx;
    callback edited(string);
    callback accepted();
    forward-focus: input;
    init => { if root.auto-focus { input.focus(); } }
    changed focus-trigger => { if root.auto-focus { input.focus(); } }
    height: root.field-height;
    clip: true;
    background: Tokens.chrome;
    border-width: root.edge;
    border-color: root.invalid ? #c98b8b : (input.has-focus ? Tokens.primary.with-alpha(0.6) : Tokens.border);
    animate border-color { duration: Tokens.transition; easing: Tokens.transition-easing; }
    if root.value == "" && root.placeholder != "": Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-family: Tokens.mono;
        font-size: 12px;
        color: root.placeholder-color;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    input := TextInput {
        x: root.numeric ? 8px : 12px;
        width: parent.width - (root.numeric ? 16px : 24px);
        height: 100%;
        text <=> root.value;
        font-family: Tokens.mono;
        font-size: 12px;
        color: root.text-color;
        selection-background-color: Tokens.ring;
        selection-foreground-color: Tokens.foreground;
        horizontal-alignment: root.numeric ? right : left;
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        accessible-label: root.field-label;
        edited => { root.edited(input.text); }
        accepted => { root.accepted(); }
    }
}

// Bordered editable path input joined to its browse button (Tauri PathInput).
export component AuthPathField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    private property <length> edge: Math.floor(1px / 1phx) * 1phx;
    callback browse();
    height: 40px;
    browse-btn := ActionArea {
        x: parent.width - self.width;
        y: 0px;
        width: 69px;
        height: parent.height;
        label: "ОБЗОР";
        background: Tokens.card;
        border-width: root.edge;
        border-color: self.hovered ? Tokens.ring : Tokens.border;
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: "ОБЗОР";
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.4px;
            color: parent.hovered ? Tokens.foreground : Tokens.secondary-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        clicked => { root.browse(); }
    }
    // Declared after browse-btn so focus border paints over the shared 1px edge (CSS focus:z-10).
    TextField {
        x: 0px;
        y: 0px;
        width: parent.width - browse-btn.width + root.edge;
        field-height: parent.height;
        field-label: root.label;
        placeholder: root.placeholder;
        value <=> root.value;
    }
}

// Primary/ghost auth action button mirroring Tauri Login/FirstRun submit buttons.
export component FormButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    in property <length> horizontal-padding: 24px;
    private property <length> edge: Math.floor(1px / 1phx) * 1phx;
    private property <bool> has-lead: root.busy || root.icon.width > 0;
    private property <bool> active-primary: root.primary && root.enabled;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    height: 40px;
    width: measure.preferred-width + (root.has-lead ? 25px : 0px) + root.horizontal-padding * 2 + 2 * root.edge;
    opacity: root.enabled ? 1 : 0.5;
    measure := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.98px;
        opacity: 0;
        accessible-role: none;
    }
    background: root.active-primary ? @linear-gradient(180deg, #2a2116, #11100d) : Tokens.chrome;
    border-width: root.edge;
    border-color: root.active-primary
        ? (touch.has-hover ? Tokens.primary : Tokens.primary.with-alpha(0.4))
        : (root.enabled && touch.has-hover ? Tokens.ring : Tokens.border);
    touch := TouchArea {
        x: 0px;
        y: 0px;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.busy: Spinner {
        x: root.edge + root.horizontal-padding;
        y: (parent.height - 13px) / 2;
        width: 13px;
        height: 13px;
    }
    if !root.busy && root.icon.width > 0: Image {
        x: root.edge + root.horizontal-padding;
        y: (parent.height - 13px) / 2;
        width: 13px;
        height: 13px;
        source: root.icon;
        colorize: Tokens.foreground;
        accessible-role: none;
    }
    Text {
        x: root.edge + root.horizontal-padding + (root.has-lead ? 25px : 0px);
        y: 0px;
        width: measure.preferred-width;
        height: parent.height;
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.98px;
        color: root.primary ? Tokens.foreground : ((root.enabled && touch.has-hover) ? Tokens.foreground : Tokens.secondary-foreground);
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Underlined text link (mode toggle, logout) matching CSS underline-offset-4.
export component LinkButton inherits ActionArea {
    in property <string> text;
    label: root.text;
    height: 19px;
    width: link-text.preferred-width;
    link-text := Text {
        x: 0px;
        y: 0px;
        height: 15px;
        text: root.text;
        font-size: 11px;
        color: parent.hovered ? Tokens.foreground : Tokens.secondary-foreground;
        vertical-alignment: center;
        accessible-role: none;
    }
    Rectangle {
        x: 0px;
        y: 17px;
        width: parent.width;
        height: 1px;
        background: parent.hovered ? Tokens.foreground : Tokens.secondary-foreground;
    }
}
