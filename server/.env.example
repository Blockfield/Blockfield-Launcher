# =============================================================================
# Blockfield API Server — Environment Variables
# =============================================================================
# Docker image: ghcr.io/netherg-io/blockfield-launcher-backend
# Port: 3000
# =============================================================================

# ── Required ───────────────────────────────────────────────────────────────────

# Public-facing origin for generated manifest URLs (e.g. https://play.blockfield.gg)
BASE_URL=http://localhost:3000

# Bearer token used to authenticate against Filament CMS
CMS_TOKEN=

# Dedicated bearer token for POST /reload (minimum 32 characters)
RELOAD_TOKEN=

# ── CMS connection ─────────────────────────────────────────────────────────────

# Filament CMS API base URL
# Local dev: http://localhost:8055/api
# In Dokploy (separate apps): https://admin.blockfield.gg/api
CMS_URL=http://localhost:8055/api

# If "true", the server refuses to start without a working CMS connection
CMS_REQUIRED=false

# CMS collection names (usually no need to change)
CMS_MODPACK_COLLECTION=modpack_releases
CMS_CONTENT_COLLECTION=launcher_content

# ── GitHub Releases — launcher update source ────────────────────────────────────

# Format: owner/repo (e.g. netherg-io/blockfield-launcher)
GITHUB_REPO=netherg-io/blockfield-launcher

# Release tag to fetch update.json from (e.g. develop, v0.5.0)
GITHUB_UPDATE_TAG=develop

# Preferred: directory containing signed update.json and installer assets.
# The dev CI packages these files into the backend image automatically.
UPDATE_DIR=server/updates

# Optional fallback for private repos when UPDATE_DIR is not populated. The
# read-only Contents PAT is used only by the backend and is never returned.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# ── Runtime ────────────────────────────────────────────────────────────────────

BIND_HOST=0.0.0.0
PORT=3000
API_PREFIX=api/launcher/v1
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:5173
MINECRAFT_SERVER_HOST=play.blockfield.gg
MINECRAFT_SERVER_PORT=25565
SERVER_REGION_CODE=UA
SERVER_LOCATION_NAME="Kyiv, Ukraine"

# ── Directories ────────────────────────────────────────────────────────────────

# Docker runtime overrides these to /data/files and /data/extracted
FILES_DIR=server/files
EXTRACTED_DIR=server/extracted

# ── Fallback content (used when CMS is unreachable) ────────────────────────────

MODPACK_VERSION=0.1.43
MINECRAFT_VERSION=1.20.1
FALLBACK_BRAND=BLOCKFIELD
FALLBACK_BRAND_SUBTITLE="TACTICAL OPS"
FALLBACK_CHROME_TITLE="BLOCKFIELD LAUNCHER"
FALLBACK_OPERATION_NAME="IRON FRONT"
FALLBACK_SERVER_IP=play.blockfield.gg:25565
# ── Verified Java runtime used when no CMS release is active ──────────────────
JAVA_VERSION=17.0.16+8
JAVA_PLATFORM=windows-x64
JAVA_URL=https://example.invalid/replace-with-an-immutable-jre-archive.zip
JAVA_SHA256=
JAVA_SIZE=

# ── Forge (defaults provided, override if needed) ───────────────────────────────
# FORGE_VERSION=1.20.1-47.4.10
# FORGE_URL=https://maven.minecraftforge.net/net/minecraftforge/forge/1.20.1-47.4.10/forge-1.20.1-47.4.10-installer.jar
# FORGE_SHA256=1912760b4cb6b803d8a826de603c9076b1da71ec2765e9a1f8c1ca78f65278e3
# FORGE_SIZE=6078070
