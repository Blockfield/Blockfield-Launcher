import { Tokens } from "tokens.slint";
import { ActionArea } from "controls.slint";

// Shared auth-screen bits (login + firstrun). Same dark-panel look as the
// Tauri LoginScreen/FirstRunScreen: 640px column, card panel, mono inputs.
export component AuthHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: 8px;
    Text {
        text: root.title;
        font-size: 26px;
        font-weight: Tokens.weight-medium;
        letter-spacing: 1.56px;
        color: #fafafa;
        vertical-alignment: center;
    }
    Text {
        text: root.hint;
        font-size: 11px;
        letter-spacing: 1.1px;
        color: Tokens.muted-foreground;
        vertical-alignment: center;
    }
}

// Two-column row mirroring SettingRow proportions without the icon column:
// 220px label block, content fills the rest.
export component FieldRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <length> content-height: 40px;
    private property <length> edge: Math.floor(1px / 1phx) * 1phx;
    // Fixed unit so auth panels can size themselves exactly: 40px field +
    // 25px label/hint stack. The dashed separator keeps the phx edge.
    height: root.content-height + 25px;
    Text {
        x: 0px;
        y: 10px;
        width: 220px;
        height: 15px;
        text: root.label;
        font-size: 11px;
        letter-spacing: 1.32px;
        color: Tokens.neutral-100;
        vertical-alignment: center;
    }
    Text {
        x: 0px;
        y: 28px;
        width: 220px;
        height: 15px;
        text: root.hint;
        font-size: 11px;
        color: Tokens.muted-foreground;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: 244px;
        y: 12px;
        width: parent.width - 244px;
        height: root.content-height;
        @children
    }
    for dash in Math.ceil(self.width / 6px): Rectangle {
        x: dash * 6px;
        y: parent.height - root.edge;
        width: Math.min(3px, parent.width - self.x);
        height: root.edge;
        background: Tokens.secondary;
    }
}

// Dark mono input matching the Tauri login fields. Raw TextInput keeps the
// house style (std LineEdit paints the OS light theme instead).
export component TextField inherits Rectangle {
    in property <string> field-label;
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> invalid;
    in property <length> field-height: 40px;
    private property <length> edge: Math.floor(1px / 1phx) * 1phx;
    callback edited(string);
    callback accepted();
    height: root.field-height;
    clip: true;
    background: Tokens.chrome;
    border-width: root.edge;
    border-color: root.invalid ? #c98b8b : (input.has-focus ? Tokens.primary : Tokens.border);
    animate border-color { duration: Tokens.transition; easing: Tokens.transition-easing; }
    if root.value == "" && root.placeholder != "": Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-family: Tokens.mono;
        font-size: 12px;
        color: Tokens.faint;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text <=> root.value;
        font-family: Tokens.mono;
        font-size: 12px;
        color: Tokens.neutral-200;
        selection-background-color: Tokens.ring;
        selection-foreground-color: Tokens.foreground;
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        accessible-label: root.field-label;
        edited => { root.edited(input.text); }
        accepted => { root.accepted(); }
    }
}

// Primary/ghost button mirroring SettingsButton (same 40px, gradient, ring).
export component FormButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    private property <length> edge: Math.floor(1px / 1phx) * 1phx;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    height: 40px;
    width: measure.preferred-width + root.horizontal-padding * 2;
    in property <length> horizontal-padding: 24px;
    opacity: root.enabled ? 1 : 0.5;
    measure := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.98px;
        opacity: 0;
    }
    background: root.primary ? @linear-gradient(180deg, #2a2116, #11100d) : Tokens.chrome;
    border-width: root.edge;
    border-color: root.primary ? (touch.has-hover ? Tokens.primary : Tokens.primary.with-alpha(0.4)) : (touch.has-hover ? Tokens.ring : Tokens.border);
    touch := TouchArea {
        x: 0px;
        y: 0px;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Text {
        x: root.horizontal-padding + 1px;
        y: 0px;
        width: measure.preferred-width;
        height: parent.height;
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.98px;
        color: (root.enabled && touch.has-hover) ? Tokens.foreground : Tokens.secondary-foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Underlined text link (mode toggle, logout).
export component LinkButton inherits ActionArea {
    in property <string> text;
    height: 15px;
    width: link-text.preferred-width;
    link-text := Text {
        x: 0px;
        height: parent.height;
        text: root.text;
        font-size: 11px;
        color: parent.hovered ? Tokens.foreground : Tokens.secondary-foreground;
        vertical-alignment: center;
    }
    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: parent.hovered ? Tokens.foreground : Tokens.secondary-foreground;
    }
}

// Single-line error box mirroring Tauri ErrorDetail (red border, card fill).
export component ErrorText inherits Rectangle {
    in property <string> message;
    private property <length> edge: Math.floor(1px / 1phx) * 1phx;
    height: 40px;
    visible: root.message != "";
    background: Tokens.card;
    border-width: root.edge;
    border-color: #c98b8b;
    Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.message;
        font-size: 12px;
        color: Tokens.neutral-200;
        vertical-alignment: center;
        overflow: elide;
    }
}
