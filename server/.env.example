# =============================================================================
# Blockfield API Server — Environment Variables
# =============================================================================
# Docker image: ghcr.io/netherg-io/blockfield-launcher-backend
# Port: 3000
# =============================================================================

# ── Required ───────────────────────────────────────────────────────────────────

# Public-facing origin for generated manifest URLs (e.g. https://play.blockfield.gg)
BASE_URL=http://localhost:3000

# Bearer token used to authenticate against Filament CMS
CMS_TOKEN=blockfield-dev-token

# ── CMS connection ─────────────────────────────────────────────────────────────

# Filament CMS API base URL
# Local dev: http://localhost:8055/api
# In Dokploy (separate apps): https://admin.blockfield.gg/api
CMS_URL=http://localhost:8055/api

# If "true", the server refuses to start without a working CMS connection
CMS_REQUIRED=false

# CMS collection names (usually no need to change)
CMS_MODPACK_COLLECTION=modpack_releases
CMS_CONTENT_COLLECTION=launcher_content
CMS_UPDATE_COLLECTION=launcher_updates

# ── Runtime ────────────────────────────────────────────────────────────────────

BIND_HOST=0.0.0.0
PORT=3000
API_PREFIX=api/launcher/v1

# ── Directories ────────────────────────────────────────────────────────────────

# Docker runtime overrides these to /data/files and /data/extracted
FILES_DIR=server/files
EXTRACTED_DIR=server/extracted

# ── Fallback content (used when CMS is unreachable) ────────────────────────────

MODPACK_VERSION=0.1.43
MINECRAFT_VERSION=1.20.1
FALLBACK_BRAND=BLOCKFIELD
FALLBACK_BRAND_SUBTITLE="TACTICAL OPS"
FALLBACK_CHROME_TITLE="BLOCKFIELD LAUNCHER"
FALLBACK_OPERATION_NAME="IRON FRONT"
FALLBACK_SERVER_IP=play.blockfield.gg:25565
FALLBACK_LAUNCHER_VERSION=0.4.2
FALLBACK_UPDATE_URL=https://play.blockfield.gg/downloads/blockfield-launcher_0.1.0_x64-setup.exe

# ── Java runtime override (optional, fetched from Mojang if absent) ────────────
# JAVA_VERSION=21.0.5
# JAVA_PLATFORM=windows
# JAVA_URL=https://...
# JAVA_SHA256=abc123...
# JAVA_SIZE=123456789

# ── Forge override (optional) ──────────────────────────────────────────────────
# FORGE_VERSION=1.20.1-47.3.0
# FORGE_URL=https://...
# FORGE_SHA256=abc123...
# FORGE_SIZE=123456789
