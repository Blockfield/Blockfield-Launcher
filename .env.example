# =============================================================================
# Blockfield Launcher — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# All variables have sensible defaults for local development.
# =============================================================================

# ── Server (blockfield-server) ───────────────────────────────────────────────

# Base URL used in generated manifest file URLs and fallback content
BASE_URL=http://localhost:3000

# Modpack version to serve when CMS is unavailable
MODPACK_VERSION=0.1.43

# Minecraft version for modpack builds — MUST match the client fallback
MINECRAFT_VERSION=1.20.1

# Bind address and port for the API server
BIND_HOST=0.0.0.0
PORT=3000

# API route prefix (no leading/trailing slash)
API_PREFIX=api/launcher/v1

# Directories for modpack ZIPs and extracted content
FILES_DIR=server/files
EXTRACTED_DIR=server/extracted

# ── Java runtime override (optional, fetched from Mojang if absent) ──────────
# JAVA_VERSION=21.0.5
# JAVA_PLATFORM=windows
# JAVA_URL=https://...
# JAVA_SHA256=abc123...
# JAVA_SIZE=123456789

# ── Forge override (optional) ────────────────────────────────────────────────
# FORGE_VERSION=1.20.1-47.3.0
# FORGE_URL=https://...
# FORGE_SHA256=abc123...
# FORGE_SIZE=123456789

# ── Filament CMS ─────────────────────────────────────────────────────────────

# Filament API URL for the Rust API server. In docker-compose this is internal:
# http://filament:8055/api
CMS_URL=http://localhost:8055/api

# Static bearer token used by the Rust API and publish script.
CMS_TOKEN=blockfield-dev-token

# If "true", the server refuses to start without a working CMS connection.
CMS_REQUIRED=false

# CMS collection names.
CMS_MODPACK_COLLECTION=modpack_releases
CMS_CONTENT_COLLECTION=launcher_content
CMS_UPDATE_COLLECTION=launcher_updates

# Filament admin runtime.
FILAMENT_APP_URL=http://localhost:8055
FILAMENT_APP_KEY=
FILAMENT_ADMIN_EMAIL=admin@example.com
FILAMENT_ADMIN_PASSWORD=admin

# ── Tauri client ─────────────────────────────────────────────────────────────

# API server URL — used by both Vite frontend (import.meta.env) and Rust backend (std::env::var)
VITE_BLOCKFIELD_API_URL=http://localhost:3000/api/launcher/v1

# Branding — used as CMS fallback in the launcher UI
VITE_BRAND=BLOCKFIELD
VITE_BRAND_SUBTITLE="TACTICAL OPS"
VITE_CHROME_TITLE="BLOCKFIELD LAUNCHER"
VITE_OPERATION_NAME="IRON FRONT"
VITE_SEASON="/ SEASON 01"
VITE_SERVER_NAME="BLOCKFIELD - PRIMARY"
VITE_LAUNCHER_VERSION=0.4.2
VITE_SERVER_IP=play.blockfield.gg:25565
VITE_SERVER_REGION="EU-WEST - 28ms"
VITE_SERVER_PING=28
VITE_SERVER_REGION_CODE=EU-W
VITE_OPERATORS=142
VITE_COORDINATES="LAT 47.3829 / LON 19.0402"
VITE_COPYRIGHT="2026 BLOCKFIELD COMMAND"
VITE_OPERATOR_HANDLE=KILO_7
VITE_OPERATOR_INITIALS=K7
VITE_LOGIN_PLACEHOLDER=operator@blockfield.gg

# ── Minecraft launcher defaults (Rust backend) ───────────────────────────────

# Override Mojang API URLs (rarely needed, but prevents hard-rebuild on URL changes)
BLOCKFIELD_MOJANG_MANIFEST_URL=https://piston-meta.mojang.com/mc/game/version_manifest_v2.json
BLOCKFIELD_MOJANG_ASSET_BASE_URL=https://resources.download.minecraft.net

# Launcher identity sent to Minecraft
BLOCKFIELD_LAUNCHER_NAME=BlockfieldLauncher
BLOCKFIELD_OFFLINE_USERNAME=Blockfield

# Default Minecraft version when manifest is unavailable
BLOCKFIELD_MINECRAFT_VERSION=1.20.1

# Java binary name (platform-specific fallback, "java" or "java.exe")
# BLOCKFIELD_JAVA_BINARY=java

# Default launcher settings
BLOCKFIELD_DEFAULT_RAM_MB=8192
BLOCKFIELD_AUTO_UPDATE=true
BLOCKFIELD_DEFAULT_LANG=en

# Player name for offline mode
BLOCKFIELD_PLAYER_NAME=Blockfield

# ── GitHub Actions / CI ─────────────────────────────────────────────────────

# Docker image names for CI builds
# BACKEND_IMAGE_NAME=ghcr.io/netherg-io/blockfield-launcher-backend
# FILAMENT_IMAGE_NAME=ghcr.io/netherg-io/blockfield-launcher-filament
