# =============================================================================
# Blockfield Launcher — Tauri Client Environment Variables
# =============================================================================
# Copy to .env for local Tauri dev (`pnpm tauri:dev`) and CI builds.
# =============================================================================

# ── API server ─────────────────────────────────────────────────────────────────

# URL of the blockfield-server API (used by both Vite frontend and Rust backend)
VITE_BLOCKFIELD_API_URL=http://localhost:3000/api/launcher/v1

# ── Branding (CMS fallback for the launcher UI) ────────────────────────────────

VITE_BRAND=BLOCKFIELD
VITE_BRAND_SUBTITLE="TACTICAL OPS"
VITE_CHROME_TITLE="BLOCKFIELD LAUNCHER"
VITE_OPERATION_NAME="IRON FRONT"
VITE_SEASON="/ SEASON 01"
VITE_SERVER_NAME="BLOCKFIELD - PRIMARY"
VITE_SERVER_IP=play.blockfield.gg:25565
VITE_COPYRIGHT="2026 BLOCKFIELD COMMAND"
VITE_LOGIN_PLACEHOLDER=operator@blockfield.gg

# ── Minecraft launcher defaults (Rust backend, src-tauri) ──────────────────────

BLOCKFIELD_MOJANG_MANIFEST_URL=https://piston-meta.mojang.com/mc/game/version_manifest_v2.json
BLOCKFIELD_MOJANG_ASSET_BASE_URL=https://resources.download.minecraft.net
BLOCKFIELD_LAUNCHER_NAME=BlockfieldLauncher
BLOCKFIELD_MINECRAFT_VERSION=1.20.1
BLOCKFIELD_DEFAULT_RAM_MB=8192
BLOCKFIELD_AUTO_UPDATE=true
BLOCKFIELD_DEFAULT_LANG=en

# Comma-separated hosts allowed for Java/Forge URLs and their redirects.
# Modpack file URLs are always restricted to VITE_BLOCKFIELD_API_URL's origin.
BLOCKFIELD_TRUSTED_DOWNLOAD_HOSTS=maven.minecraftforge.net

# Manifest safety ceilings (bytes unless stated otherwise).
BLOCKFIELD_MAX_MANIFEST_BYTES=8388608
BLOCKFIELD_MAX_MANIFEST_FILES=100000
BLOCKFIELD_MAX_MANIFEST_FILE_BYTES=17179869184
BLOCKFIELD_MAX_MANIFEST_PAYLOAD_BYTES=68719476736

# ZIP extraction safety ceilings.
BLOCKFIELD_MAX_ARCHIVE_BYTES=2147483648
BLOCKFIELD_MAX_EXTRACTED_BYTES=17179869184
BLOCKFIELD_MAX_ARCHIVE_ENTRY_BYTES=4294967296
BLOCKFIELD_MAX_ARCHIVE_ENTRIES=200000
BLOCKFIELD_MAX_ARCHIVE_RATIO=1000
BLOCKFIELD_MAX_ARCHIVE_DEPTH=32
BLOCKFIELD_MIN_FREE_SPACE_BYTES=2147483648
