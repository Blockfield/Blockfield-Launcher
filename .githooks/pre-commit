#!/usr/bin/env bash
set -euo pipefail

# ── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

PASS=0

# ── Staged files ────────────────────────────────────────────────────────────
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# ── Helpers ─────────────────────────────────────────────────────────────────
section() {
    echo -e "\n${CYAN}═════════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}  $*${NC}"
    echo -e "${CYAN}═════════════════════════════════════════════════════════════${NC}"
}

check_step() {
    local label="$1"
    shift
    echo -e "${YELLOW}▶ ${label}${NC}"
    if "$@"; then
        echo -e "${GREEN}✓ ${label} passed${NC}"
    else
        echo -e "${RED}✗ ${label} FAILED${NC}"
        PASS=1
    fi
}

has_files() {
    # Return true if any staged file matches the given grep pattern
    echo "$STAGED" | grep -qE "$1"
}

# ── Auto-format ─────────────────────────────────────────────────────────────
# Format the staged files with the repo's own pinned formatters and re-stage
# them, so the checks below see the formatted tree. Unstaged work is untouched.
if [ -n "$STAGED" ]; then
    command -v just >/dev/null 2>&1 || {
        echo -e "${RED}pre-commit: 'just' not found on PATH; run just setup first${NC}" >&2
        exit 1
    }
    just format-staged
    STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
fi

# ── Rust (core workspace + native launcher) ─────────────────────────────────
if has_files '\.rs$|\.slint$|Cargo\.(toml|lock)$'; then
    section "Rust — core workspace & native launcher"

    RUST_ENV="$(git rev-parse --show-toplevel)/scripts/rust-env.sh"
    check_step "cargo fmt --check" "$RUST_ENV" cargo fmt --all -- --check
    check_step "cargo clippy -- -D warnings" "$RUST_ENV" cargo clippy --workspace --all-targets -- -D warnings
    check_step "cargo test" "$RUST_ENV" cargo test --workspace
    if has_files '^native/'; then
        check_step "native cargo fmt --check" "$RUST_ENV" cargo fmt --manifest-path native/app/Cargo.toml --all -- --check
        check_step "native cargo clippy -- -D warnings" "$RUST_ENV" cargo clippy --manifest-path native/app/Cargo.toml --all-targets -- -D warnings
    fi
else
    echo -e "${CYAN}⏭  Rust — no changes, skipped${NC}"
fi

# ── Result ──────────────────────────────────────────────────────────────────
echo
if [ "$PASS" -ne 0 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}  ✗ Pre-commit checks FAILED. Fix the issues and try again.${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}  ✓ All pre-commit checks passed${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
exit 0
