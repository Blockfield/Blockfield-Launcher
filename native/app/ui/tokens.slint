export global Tokens {
    // WebKit zoom snaps borders and line boxes to whole physical pixels.
    public pure function line-height(height: length, pixel: length) -> length { return Math.floor(height / pixel) * pixel; }
    out property <color> background: #070604;
    out property <color> foreground: #f3e7d0;
    out property <color> chrome: #0b0906;
    out property <color> card: #11100d;
    out property <color> secondary: #18130d;
    out property <color> primary: #f5a524;
    out property <color> secondary-foreground: #c7ae86;
    out property <color> muted-foreground: #8e7a5e;
    out property <color> faint: #5e5040;
    out property <color> border: #2a2116;
    out property <color> ring: #8a571c;
    out property <color> success: #82d66b;
    out property <color> destructive: #ff5c5c;
    out property <color> close-hover: #5a1714;
    out property <color> neutral-100: #f5f5f5;
    out property <color> neutral-200: #e5e5e5;
    out property <length> base-size: 16px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> radius-xl: 12px;
    out property <length> spacing: 4px;
    out property <length> chrome-height: 36px;
    out property <length> header-height: 56px;
    out property <length> footer-height: 32px;
    out property <length> grid-step: 48px;
    out property <length> text-xs: 9px;
    out property <length> text-label: 10px;
    out property <length> text-small: 11px;
    out property <length> text-brand: 13px;
    out property <int> weight-normal: 400;
    out property <int> weight-medium: 600;
    out property <length> tracking-chrome: 3px;
    out property <length> tracking-nav: 2.8px;
    out property <length> tracking-brand: 2.86px;
    out property <length> tracking-subtitle: 1.62px;
    out property <length> tracking-role: 1.08px;
    out property <length> tracking-user: 1.1px;
    out property <length> tracking-footer: 1.6px;
    out property <duration> transition: 150ms;
    out property <easing> transition-easing: cubic-bezier(0.4, 0, 0.2, 1);
    out property <duration> pulse-half: 1000ms;
    out property <easing> pulse-easing: cubic-bezier(0.4, 0, 0.6, 1);
    out property <string> sans: "Inter";
    out property <string> mono: "IBM Plex Mono";
}
