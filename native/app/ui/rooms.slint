import { Tokens } from "tokens.slint";
import { MainButton } from "main-controls.slint";
import { MainSelect } from "select.slint";

// One capture point of a live battle (Tauri BattlePoints cell): label, sub
// line and color tone are precomputed in Rust so the view stays dumb.
export struct BattlePoint { label: string, sub: string, progress: int, tone: int }

export struct Room {
    id: string,
    name: string,
    description: string,
    players: int,
    ready: string,
    join: string,
    joinable: bool,
    battle-red: int,
    battle-blue: int,
    has-battle: bool,
    points: [BattlePoint],
}

// Ongoing-matches list (Tauri RoomList): room dropdown + join, mode/map/phase
// line, players/ready, live battle scores with capture-point bars and pager,
// prev/next pager and lobby join. Empty states mirror the Tauri copy.
export component RoomList inherits Rectangle {
    in property <[Room]> rooms;
    in property <[string]> room-names;
    in-out property <int> room-index: 0;
    in property <bool> rooms-available: true;
    in property <string> maintenance: "";
    in property <bool> updating: false;
    in property <bool> room-disabled: false;
    callback join(string);
    private property <Room> room: root.rooms[root.room-index];
    private property <int> point-page: 0;
    private property <int> point-pages: Math.max(1, Math.ceil(root.room.points.length / 3.0));
    changed room-index => { root.point-page = 0; }

    if root.rooms.length > 0: Rectangle { x: 0px; y: 0px;
        MainSelect { x: 0px; y: 0px; width: parent.width - join-button.width - 12px; label: "Выбрать матч"; options: root.room-names; selected <=> root.room-index; }
        join-button := MainButton { y: 0px; x: parent.width - self.width; label: root.room.join + ": " + root.room.name; text: root.room.join; selected: true; enabled: !root.room-disabled && !root.updating && root.room.joinable; clicked => { if self.enabled { root.join(root.room.id); } } }
        Text { x: 0px; y: 40px; height: 18px; width: parent.width; text: root.room.description; color: Tokens.secondary-foreground; font-size: 12px; overflow: elide; }
        HorizontalLayout { x: 0px; y: 66px; height: 18px; alignment: start; spacing: 20px;
            Text { text: "Игроков: " + root.room.players; color: Tokens.secondary-foreground; font-size: 12px; }
            Text { text: root.room.ready; color: Tokens.secondary-foreground; font-size: 12px; }
        }
        if root.room.has-battle: Rectangle { x: 0px; y: 92px; width: parent.width; height: 68px;
            HorizontalLayout { x: 0px; y: 0px; height: 18px; alignment: start; spacing: 20px;
                Text { text: "Красные: " + root.room.battle-red; color: #ff9d99; font-size: 12px; font-weight: Tokens.weight-medium; }
                Text { text: "Синие: " + root.room.battle-blue; color: #91c8ff; font-size: 12px; font-weight: Tokens.weight-medium; }
            }
            grid := Rectangle { x: 0px; y: 24px; width: parent.width - (root.point-pages > 1 ? 72px : 0px); height: 44px;
                HorizontalLayout { x: 0px; y: 0px; width: parent.width; height: parent.height; spacing: 12px; alignment: start;
                    for i in 3: Rectangle { width: (parent.width - 24px) / 3;
                        if root.point-page * 3 + i < root.room.points.length: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height;
                            Text { x: 0px; y: 0px; width: parent.width; height: 14px; text: root.room.points[root.point-page * 3 + i].label; color: Tokens.secondary-foreground; font-size: 11px; overflow: elide; vertical-alignment: center; }
                            Rectangle { x: 0px; y: 18px; width: parent.width; height: 6px; background: Tokens.border;
                                Rectangle { x: 0px; y: 0px; width: parent.width * Math.min(100, Math.max(0, root.room.points[root.point-page * 3 + i].progress)) / 100; height: parent.height;
                                    background: root.room.points[root.point-page * 3 + i].tone == 1 ? #ff9d99 : root.room.points[root.point-page * 3 + i].tone == 2 ? #91c8ff : Tokens.secondary-foreground; }
                            }
                            Text { x: 0px; y: 28px; width: parent.width; height: 14px; text: root.room.points[root.point-page * 3 + i].sub; color: Tokens.secondary-foreground; font-size: 11px; overflow: elide; vertical-alignment: center; }
                        }
                    }
                }
            }
            if root.point-pages > 1: MainButton { x: grid.x + grid.width + 8px; y: 24px; label: "Следующие точки захвата"; text: (root.point-page + 1) + "/" + root.point-pages; clicked => { root.point-page = Math.mod(root.point-page + 1, root.point-pages); } }
        }
    }
    if root.rooms.length == 0: Text { x: 0px; y: 0px;
        width: parent.width; text: root.maintenance != "" ? "Идут технические работы: " + root.maintenance + ". Матчи откроются после завершения работ." : root.updating ? "Игровой сервер обновляется — лобби открыто. Нажмите «Играть» — вас перенесут в игру, когда сервер запустится." : !root.rooms-available ? "Список матчей недоступен. Повторим запрос автоматически." : "Сейчас матчей нет. Нажмите «Играть» и выберите режим в хабе: Casual или Рейтинг.";
        color: Tokens.secondary-foreground; font-size: 12px; wrap: word-wrap; line-height-factor: 1.625 * 2048 / 2478;
    }
    Rectangle { x: 0px; y: parent.height - 41px; height: 1px; background: Tokens.border; }
    if root.rooms.length > 0: HorizontalLayout { x: 0px;
        y: parent.height - 32px; height: 32px; width: self.preferred-width; alignment: start; spacing: 8px;
        MainButton { label: "Предыдущий матч"; text: ""; icon: @image-url("../assets/icons/chevron-left.svg"); enabled: root.room-index > 0; clicked => { if self.enabled { root.room-index -= 1; } } }
        Text { text: (root.room-index + 1) + " / " + root.rooms.length; color: Tokens.secondary-foreground; font-size: 12px; vertical-alignment: center; }
        MainButton { label: "Следующий матч"; text: ""; icon: @image-url("../assets/icons/chevron-right.svg"); enabled: root.room-index + 1 < root.rooms.length; clicked => { if self.enabled { root.room-index += 1; } } }
    }
    MainButton { x: parent.width - self.width; y: parent.height - 32px; label: "Войти в лобби"; enabled: !root.room-disabled; clicked => { if self.enabled { root.join("lobby"); } } }
}
