import { Tokens } from "tokens.slint";
import { ActionArea } from "controls.slint";
import { GridBackdrop, TopoBackdrop } from "backdrop.slint";
import { SkinPreview } from "../../skin3d/src/slint_preview.slint";

component SettingsTabButton inherits Rectangle {
    in property <string> label;
    in property <bool> current;
    callback chosen();
    // e2e hook only: exposes the tab to the Slint testing tree, no pixels change.
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }
    height: 44px;
    background: root.current ? Tokens.secondary : (press-touch.has-hover ? Tokens.card : transparent);
    tab-text := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - 2px;
        text: root.label;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.88px;
        color: root.current ? Tokens.foreground : (press-touch.has-hover ? Tokens.foreground : Tokens.secondary-foreground);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.current: Rectangle { x: 0px; y: parent.height - 2px; width: parent.width; height: 2px; background: Tokens.primary; }
    press-touch := TouchArea {
        x: 0px;
        y: 0px;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.chosen(); }
    }
    keys := FocusScope {
        x: 0px;
        y: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.chosen();
                return accept;
            }
            return reject;
        }
    }
    if keys.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: root.width - 4px;
        height: root.height - 4px;
        border-width: 2px;
        border-color: Tokens.primary;
    }
}

component SettingRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <[string]> hint;
    // CSS rows use 12px vertical padding and a 260px label column.
    in property <length> row-height;
    private property <length> edge: Math.floor(1px / 1phx) * 1phx;
    private property <length> label-leading: Math.floor(16.5px / 1phx) * 1phx;
    private property <length> hint-leading: Math.floor(15.125px / 1phx) * 1phx;
    height: root.row-height;
    Rectangle {
        x: 0px;
        y: 14px;
        width: 28px;
        height: 28px;
        background: Tokens.chrome;
        border-width: Math.floor(1px / 1phx) * 1phx;
        border-color: Tokens.border;
        Image {
            x: 7px;
            y: 7px;
            width: 14px;
            height: 14px;
            source: root.icon;
            colorize: Tokens.primary;
        }
    }
    Text {
        x: 40px;
        y: 12px;
        width: 220px;
        height: 15px;
        text: root.label;
        font-size: 11px;
        letter-spacing: 1.32px;
        color: Tokens.neutral-100;
        vertical-alignment: center;
    }
    // CSS leading-snug is 1.375; Slint's multiline leading is font-dependent.
    for line[index] in root.hint: Text {
        x: 40px;
        y: 16px + root.label-leading + index * root.hint-leading;
        width: 220px;
        height: root.hint-leading;
        text: line;
        font-size: 11px;
        color: Tokens.muted-foreground;
    }
    Rectangle {
        x: 284px;
        y: 12px;
        width: root.width - 284px;
        height: root.height - 24px - root.edge;
        @children
    }
    for dash in Math.ceil(root.width / 6px): Rectangle {
        x: dash * 6px; y: root.height - root.edge; width: Math.min(3px, root.width - self.x); height: root.edge; background: Tokens.secondary;
    }
}

component PathField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback browse();
    height: 40px;
    clip: true;
    background: Tokens.chrome;
    border-width: Math.floor(1px / 1phx) * 1phx;
    border-color: Tokens.border;
    field-text := Text {
        x: 12px;
        y: 0px;
        width: parent.width - 79px;
        height: parent.height;
        text: root.value;
        font-family: Tokens.mono;
        font-size: 12px;
        color: Tokens.neutral-200;
        vertical-alignment: center;
        overflow: elide;
    }
    browse-button := ActionArea {
        x: root.width - self.width;
        y: 0px;
        width: 67px;
        height: parent.height;
        label: "ОБЗОР";
        background: Tokens.card;
        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Tokens.border; }
        browse-label := Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: "ОБЗОР";
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.4px;
            color: parent.hovered ? Tokens.foreground : Tokens.secondary-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        clicked => { root.browse(); }
    }
    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width - 67px;
        mouse-cursor: text;
        clicked => { root.browse(); }
    }
}

component SettingsToggle inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    in property <string> on-label;
    in property <string> off-label;
    callback toggled(bool);
    // e2e hook only: exposes the toggle to the Slint testing tree, no pixels change.
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(!root.on); }
    width: 64px;
    height: 28px;
    track := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
    Rectangle {
        x: 0px;
        y: 0px;
        width: 56px;
        height: 28px;
        background: root.on ? Tokens.border : Tokens.chrome;
        border-width: Math.floor(1px / 1phx) * 1phx;
        border-color: root.on ? Tokens.primary.with-alpha(0.6) : Tokens.border;
        Rectangle {
            x: root.on ? 31px : 3px;
            y: 4px;
            width: 20px;
            height: 20px;
            background: root.on ? Tokens.primary : #3a2c1d;
            animate x { duration: 150ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
        }
    }
    Text {
        x: 0px;
        y: 35px;
        width: 56px;
        height: 12px;
        text: root.on ? root.on-label : root.off-label;
        font-size: 9px;
        letter-spacing: 1.44px;
        color: root.on ? Tokens.primary : Tokens.muted-foreground;
        horizontal-alignment: right;
    }
}

component SettingsButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <length> horizontal-padding: 24px;
    callback clicked();
    // e2e hook only: exposes the button to the Slint testing tree, no pixels change.
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    height: 40px;
    width: measure.preferred-width + (root.icon.width > 0 ? 25px : 0px) + root.horizontal-padding * 2;
    opacity: root.enabled ? 1 : 0.5;
    measure := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.98px;
        opacity: 0;
    }
    background: root.primary ? @linear-gradient(180deg, #2a2116, #11100d) : Tokens.chrome;
    border-width: Math.floor(1px / 1phx) * 1phx;
    border-color: root.primary ? (touch.has-hover ? Tokens.primary : Tokens.primary.with-alpha(0.4)) : (touch.has-hover ? Tokens.ring : Tokens.border);
    touch := TouchArea {
        x: 0px;
        y: 0px;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.icon.width > 0: Image {
        x: root.horizontal-padding + 1px;
        y: 13.5px;
        width: 13px;
        height: 13px;
        source: root.icon;
        colorize: Tokens.foreground;
    }
    caption := Text {
        x: root.icon.width > 0 ? root.horizontal-padding + 26px : root.horizontal-padding + 1px;
        y: 0px;
        width: measure.preferred-width;
        height: parent.height;
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.98px;
        color: root.icon.width > 0 || (root.enabled && touch.has-hover) ? Tokens.foreground : Tokens.secondary-foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SettingsScreen inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> tab: 3;
    in property <string> title;
    in property <string> subtitle;
    in property <string> skin-path;
    in property <string> cape-path;
    in-out property <bool> slim: false;
    in property <image> skin-frame;
    in property <string> skin-error;
    in property <string> caption;
    in property <bool> dirty: false;
    callback browse-skin();
    callback browse-cape();
    callback upload();
    callback toggle-slim(bool);
    callback reset();
    callback save();
    callback tab-changed(int);
    callback drag-state(bool);
    callback drag-by(float, float);
    // WebKit floors CSS borders after zoom; phx preserves that at fractional DPI.
    private property <length> edge: Math.floor(1px / 1phx) * 1phx;
    private property <length> label-leading: Math.floor(16.5px / 1phx) * 1phx;
    private property <length> hint-leading: Math.floor(15.125px / 1phx) * 1phx;
    private property <length> skin-row-height: root.label-leading + 3 * root.hint-leading + 28px + root.edge;
    private property <length> cape-row-height: 64px + root.edge;
    private property <length> model-row-height: root.label-leading + root.hint-leading + 28px + root.edge;
    background: Tokens.background;
    TopoBackdrop { x: 0px; y: 0px; }
    GridBackdrop { x: 0px; y: 0px; intensity: 0.4; }
    content := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 20px;
        width: Math.min(1600px, parent.width) - 40px;
        height: parent.height - 40px;
        title-text := Text {
            x: 0px;
            // Taller than the 26px line box so semibold ascenders (Й breve) are not
            // clipped; symmetric around y13 keeps glyph and panel geometry fixed.
            y: -4px;
            height: 34px;
            text: root.title;
            font-size: 26px;
            font-weight: 600;
            letter-spacing: 1.56px;
            color: #fafafa;
            vertical-alignment: center;
        }
        Text {
            x: title-text.preferred-width + 12px;
            y: 0px;
            height: 26px;
            text: root.subtitle;
            font-size: 10px;
            letter-spacing: 1.8px;
            color: Tokens.muted-foreground;
            vertical-alignment: bottom;
        }
        panel := Rectangle {
            x: 0px;
            y: Math.floor(26px / 1phx) * 1phx + 16px;
            width: parent.width;
            height: parent.height - self.y;
            background: Tokens.card;
            border-width: Math.floor(1px / 1phx) * 1phx;
            border-color: Tokens.border;
            tabbar := Rectangle {
                x: root.edge;
                y: root.edge;
                width: parent.width - 2 * root.edge;
                height: 44px + root.edge;
                background: Tokens.chrome;
                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Tokens.border; }
                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    alignment: start;
                    spacing: 0px;
                    for entry[index] in root.tabs: SettingsTabButton {
                        width: tabbar.width / root.tabs.length;
                        label: entry;
                        current: root.tab == index;
                        chosen => {
                            root.tab = index;
                            root.tab-changed(index);
                        }
                    }
                }
            }
            body := Rectangle {
                x: root.edge;
                y: 44px + 2 * root.edge;
                width: parent.width - 2 * root.edge;
                height: actions.y - self.y;
                clip: true;
                if root.tab == 3: skin-content := Rectangle {
                    x: 20px;
                    y: 8px;
                    width: parent.width - 40px;
                    height: parent.height - 16px;
                    form := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width - 260px - 2 * root.edge;
                        height: parent.height;
                        SettingRow {
                            y: 0px;
                            width: parent.width;
                            icon: @image-url("../assets/icons/shirt.svg");
                            label: "СКИН";
                            hint: ["PNG 64×64. Без загрузки на сервере", "остаётся скин лицензионного аккаунта с", "таким ником."];
                            row-height: root.skin-row-height;
                            PathField {
                                x: 0px;
                                y: (parent.height - 24px - root.edge - self.height) / 2;
                                width: parent.width - 284px;
                                label: "СКИН";
                                value: root.skin-path;
                                browse => { root.browse-skin(); }
                            }
                        }
                        SettingRow {
                            y: root.skin-row-height;
                            width: parent.width;
                            icon: @image-url("../assets/icons/shirt.svg");
                            label: "ПЛАЩ";
                            hint: ["PNG 64×32. Необязательно."];
                            row-height: root.cape-row-height;
                            PathField {
                                x: 0px;
                                y: (parent.height - 24px - root.edge - self.height) / 2;
                                width: parent.width - 284px;
                                label: "ПЛАЩ";
                                value: root.cape-path;
                                browse => { root.browse-cape(); }
                            }
                        }
                        SettingRow {
                            y: root.skin-row-height + root.cape-row-height;
                            width: parent.width;
                            icon: @image-url("../assets/icons/user-round.svg");
                            label: "ТОНКИЕ РУКИ";
                            hint: ["Модель Alex (3px) вместо Steve (4px)."];
                            row-height: root.model-row-height;
                            SettingsToggle {
                                x: 0px;
                                y: (parent.height - 24px - root.edge - self.height) / 2;
                                label: "ТОНКИЕ РУКИ";
                                on: root.slim;
                                on-label: "ВКЛ";
                                off-label: "ВЫКЛ";
                                toggled(value) => { root.toggle-slim(value); }
                            }
                        }
                        upload-row := Rectangle {
                            y: root.skin-row-height + root.cape-row-height + root.model-row-height;
                            width: parent.width;
                            height: 56px;
                            SettingsButton {
                                x: parent.width - self.width;
                                y: 12px;
                                text: "ЗАГРУЗИТЬ";
                                icon: @image-url("../assets/icons/upload.svg");
                                primary: true;
                                enabled: root.skin-path != "" || root.cape-path != "";
                                clicked => { root.upload(); }
                            }
                        }
                    }
                    preview-panel := Rectangle {
                        x: parent.width - self.width;
                        y: 0px;
                        width: 236px + 2 * root.edge;
                        height: 339px + 2 * root.edge;
                        background: #0b0906;
                        border-width: Math.floor(1px / 1phx) * 1phx;
                        border-color: Tokens.border;
                        SkinPreview {
                            x: 8px + root.edge;
                            y: 8px + root.edge;
                            frame: root.skin-frame;
                            drag-state(active) => { root.drag-state(active); }
                            drag-by(dx, dy) => { root.drag-by(dx, dy); }
                            accessible-role: image;
                            accessible-label: "Анимированный скин Minecraft; вращайте перетаскиванием";
                        }
                        Text {
                            x: 8px + root.edge;
                            y: 316px + root.edge;
                            width: 220px;
                            height: 14px;
                            text: root.caption;
                            font-size: 10px;
                            letter-spacing: 1.8px;
                            color: Tokens.muted-foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if root.skin-error != "": Text {
                            x: 9px;
                            y: 330px;
                            width: 220px;
                            height: 12px;
                            text: root.skin-error;
                            font-size: 10px;
                            color: #c98b8b;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
            actions := Rectangle {
                x: root.edge;
                y: parent.height - 64px - 2 * root.edge;
                width: parent.width - 2 * root.edge;
                height: 64px + root.edge;
                background: Tokens.chrome;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: #18130d; }
                HorizontalLayout {
                    x: parent.width - self.preferred-width - 20px;
                    y: 13px;
                    height: 40px;
                    spacing: 12px;
                    alignment: start;
                    SettingsButton {
                        text: "СБРОС";
                        horizontal-padding: 20px;
                        clicked => { root.reset(); }
                    }
                    SettingsButton {
                        text: "СОХРАНИТЬ";
                        icon: @image-url("../assets/icons/save.svg");
                        enabled: root.dirty;
                        clicked => { root.save(); }
                    }
                }
            }
        }
    }
    changed tab => { root.tab-changed(root.tab); }
}
