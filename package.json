{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "1.0.14",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write \"{src,scripts}/**/*.{ts,tsx,mjs,css,json}\" \"*.{mjs,json,html}\"",
    "format:check": "prettier --check \"{src,scripts}/**/*.{ts,tsx,mjs,css,json}\" \"*.{mjs,json,html}\"",
    "version:check": "node scripts/check-version.mjs",
    "config:check": "node scripts/validate-production-config.mjs",
    "config:test": "node --test scripts/validate-production-config.test.mjs scripts/windows-installer.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:watch": "vitest",
    "legacy:check": "python3 scripts/check-legacy-cleanup.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "lucide-react": "1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  },
  "license": "GPL-3.0-only"
}
