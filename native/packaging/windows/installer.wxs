<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?if $(var.DevBuild) = "1" ?>
    <?define ProductDisplayName = "Blockfield Launcher DEV" ?>
    <?define ProductSlug = "blockfield-launcher-dev" ?>
    <?define UpgradeCodeGuid = "A8F3D192-4C7B-4E15-9A63-1D2E5F8A7B40" ?>
    <?define MainExecCompGuid = "E2A4B6C8-1D3F-4E5A-8B7C-9D0E1F2A3B4C" ?>
    <?define ShortcutCompGuid = "F3B5C7D9-2E4A-4F6B-9C8D-0E1F2A3B4C5D" ?>
  <?else?>
    <?define ProductDisplayName = "Blockfield Launcher" ?>
    <?define ProductSlug = "blockfield-launcher" ?>
    <?define UpgradeCodeGuid = "7B2C4A91-6D1E-4F3A-9C82-E5A14B0F3D89" ?>
    <?define MainExecCompGuid = "4D8F1E22-9A5C-4B73-8E16-2C9F0A6D4E11" ?>
    <?define ShortcutCompGuid = "C17A5D90-3E4B-48F2-A915-7D2E4B8C6A33" ?>
  <?endif?>

  <Product Id="*"
           Name="$(var.ProductDisplayName)"
           Language="1033"
           Version="$(var.MsiVersion)"
           Manufacturer="Blockfield"
           UpgradeCode="$(var.UpgradeCodeGuid)">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Description="$(var.ProductDisplayName)" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://blockfield.pro" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductSlug)" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductDisplayName)" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutableComponent" Guid="$(var.MainExecCompGuid)">
        <File Id="MainExecutable" Name="$(var.ProductSlug).exe" Source="$(var.BinaryPath)" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Blockfield\$(var.ProductSlug)"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>

      <?if $(var.DevBuild) != "1" ?>
      <Component Id="UriSchemesComponent" Guid="9E3B6C14-2F8A-4D51-B740-6A1E8D3C5F22">
        <RegistryKey Root="HKCU" Key="Software\Classes\blockfield">
          <RegistryValue Type="string" Value="URL:com.blockfield.launcher protocol" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]$(var.ProductSlug).exe&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]$(var.ProductSlug).exe&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\discord-$(var.DiscordAppId)">
          <RegistryValue Type="string" Value="URL:com.blockfield.launcher protocol" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]$(var.ProductSlug).exe&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]$(var.ProductSlug).exe&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryValue Root="HKCU"
                       Key="Software\Blockfield\$(var.ProductSlug)"
                       Name="UriSchemes"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <?endif?>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcutComponent" Guid="$(var.ShortcutCompGuid)">
        <Shortcut Id="StartMenuShortcut"
                  Name="$(var.ProductDisplayName)"
                  Description="Blockfield game launcher"
                  Target="[INSTALLFOLDER]$(var.ProductSlug).exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveProgramMenuDir" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Blockfield\$(var.ProductSlug)"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainApplication" Title="$(var.ProductDisplayName)" Level="1">
      <ComponentRef Id="MainExecutableComponent" />
      <?if $(var.DevBuild) != "1" ?>
      <ComponentRef Id="UriSchemesComponent" />
      <?endif?>
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <!-- Ownership-aware cleanup on true uninstall only; upgrades set UPGRADINGPRODUCTCODE. -->
    <CustomAction Id="RunUninstallCleanup"
                  FileKey="MainExecutable"
                  ExeCommand="--uninstall-cleanup"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="RunUninstallCleanup" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
