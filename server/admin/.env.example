# =============================================================================
# Filament CMS — Environment Variables
# =============================================================================
# Docker image: ghcr.io/netherg-io/blockfield-launcher-filament
# Port: 8055
# =============================================================================

# ── Required ───────────────────────────────────────────────────────────────────

# Stable Laravel app key — generate once and keep between deploys
# Generate: printf 'base64:%s\n' "$(openssl rand -base64 32)"
FILAMENT_APP_KEY=

# Bearer token the API server uses to authenticate CMS requests
# Generate: openssl rand -hex 32
CMS_TOKEN=blockfield-dev-token

# Admin panel credentials (created on first deploy via seeder)
FILAMENT_ADMIN_EMAIL=admin@example.com
FILAMENT_ADMIN_PASSWORD=admin

# ── Runtime ────────────────────────────────────────────────────────────────────

# Public-facing origin (e.g. https://admin.blockfield.gg)
FILAMENT_APP_URL=http://localhost:8055

APP_ENV=production
APP_DEBUG=false

# ── Storage ────────────────────────────────────────────────────────────────────

# SQLite database path (inside the /data volume)
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
FILESYSTEM_DISK=local
