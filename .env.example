# =============================================================================
# Blockfield Launcher — Environment Variables
# =============================================================================
# Export these variables in your shell before running `just dev` (e.g.
# `set -a; source .env; set +a; just dev`); `justfile` does not auto-load `.env`.
# =============================================================================

# ── Modpack host ───────────────────────────────────────────────────────────────

# Directory URL of the packwiz pack: serves pack.toml, index.toml, launcher.json and
# content.json.
VITE_BLOCKFIELD_PACK_URL=https://blockfield.pro

# Second pack for the Workshop profile: the Workshop profile installs and
# hash-checks this pack into its own game directory.
VITE_BLOCKFIELD_WORKSHOP_PACK_URL=https://blockfield.pro/workshop-pack

# ── Minecraft launcher defaults (core/launcher-core) ──────────────────────────

BLOCKFIELD_MOJANG_MANIFEST_URL=https://piston-meta.mojang.com/mc/game/version_manifest_v2.json
BLOCKFIELD_MOJANG_ASSET_BASE_URL=https://resources.download.minecraft.net
BLOCKFIELD_FABRIC_META_URL=https://meta.fabricmc.net
BLOCKFIELD_LAUNCHER_NAME=BlockfieldLauncher
BLOCKFIELD_MINECRAFT_VERSION=1.21.1
BLOCKFIELD_DEFAULT_RAM_MB=4096
BLOCKFIELD_AUTO_UPDATE=true
BLOCKFIELD_DEFAULT_LANG=en

# Optional initial Workshop target. Keep empty until its distinct virtual host is
# configured as BLOCKFIELD_WORKSHOP_HOST on the proxy; players can set it in Settings.
BLOCKFIELD_WORKSHOP_SERVER=

# ZIP extraction safety ceilings.
BLOCKFIELD_MAX_ARCHIVE_BYTES=2147483648
BLOCKFIELD_MAX_EXTRACTED_BYTES=17179869184
BLOCKFIELD_MAX_ARCHIVE_ENTRY_BYTES=4294967296
BLOCKFIELD_MAX_ARCHIVE_ENTRIES=200000
BLOCKFIELD_MAX_ARCHIVE_RATIO=1000
BLOCKFIELD_MAX_ARCHIVE_DEPTH=32
BLOCKFIELD_MIN_FREE_SPACE_BYTES=2147483648
