# =============================================================================
# Blockfield Launcher — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# All variables have sensible defaults for local development.
# =============================================================================

# ── Server (blockfield-server) ───────────────────────────────────────────────

# Base URL used in generated manifest file URLs and fallback content
BASE_URL=http://localhost:3000

# Modpack version to serve when CMS is unavailable
MODPACK_VERSION=0.1.43

# Minecraft version for modpack builds — MUST match the client fallback
MINECRAFT_VERSION=1.20.1

# Bind address and port for the API server
BIND_HOST=0.0.0.0
PORT=3000

# API route prefix (no leading/trailing slash)
API_PREFIX=api/launcher/v1

# Directories for modpack ZIPs and extracted content
FILES_DIR=server/files
EXTRACTED_DIR=server/extracted

# ── Java runtime override (optional, fetched from Mojang if absent) ──────────
# JAVA_VERSION=21.0.5
# JAVA_PLATFORM=windows
# JAVA_URL=https://...
# JAVA_SHA256=abc123...
# JAVA_SIZE=123456789

# ── Forge override (optional) ────────────────────────────────────────────────
# FORGE_VERSION=1.20.1-47.3.0
# FORGE_URL=https://...
# FORGE_SHA256=abc123...
# FORGE_SIZE=123456789

# ── Directus CMS ─────────────────────────────────────────────────────────────

# Directus API URL (set to empty or leave unset to disable CMS, use fallbacks)
DIRECTUS_URL=http://localhost:8055

# Static token for Directus API access
DIRECTUS_TOKEN=blockfield-dev-token

# If "true", the server refuses to start without a working CMS connection
DIRECTUS_REQUIRED=false

# Directus collection names
DIRECTUS_MODPACK_COLLECTION=modpack_releases
DIRECTUS_CONTENT_COLLECTION=launcher_content
DIRECTUS_UPDATE_COLLECTION=launcher_updates

# ── Directus Admin (used by bootstrap script and docker-compose) ──────────────
DIRECTUS_KEY=replace-with-random-value
DIRECTUS_SECRET=replace-with-random-value
DIRECTUS_ADMIN_EMAIL=admin@localhost
DIRECTUS_ADMIN_PASSWORD=d1r3ctu5
DIRECTUS_ADMIN_TOKEN=blockfield-dev-token
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_IMAGE=directus/directus:latest

# ── Bootstrap seed data (only used when CMS collections are empty) ───────────

# Modpack release seed
SEED_RELEASE_VERSION=0.1.0

# Launcher update seed
SEED_UPDATE_VERSION=0.1.0
SEED_UPDATE_NOTES=No launcher update available.
SEED_UPDATE_PUB_DATE=2026-06-18T00:00:00Z
SEED_UPDATE_WINDOWS_URL=https://play.blockfield.gg/downloads/blockfield-launcher_0.1.0_x64-setup.exe
SEED_UPDATE_WINDOWS_SIGNATURE=

# Launcher content seed (branding, server info, etc.)
SEED_BRAND=BLOCKFIELD
SEED_BRAND_SUBTITLE=TACTICAL OPS
SEED_CHROME_TITLE=BLOCKFIELD LAUNCHER
SEED_OPERATION_NAME=IRON FRONT
SEED_SEASON=/ SEASON 01
SEED_DESCRIPTION=Large-scale tactical PvP across contested terrain.
SEED_SERVER_NAME=BLOCKFIELD - PRIMARY
SEED_SERVER_IP=play.blockfield.gg:25565
SEED_SERVER_REGION=EU-WEST - 28ms
SEED_OPERATORS=142
SEED_PING=28
SEED_REGION=EU-W
SEED_LAUNCHER_VERSION=0.4.2
SEED_COORDINATES=LAT 47.3829 / LON 19.0402
SEED_COPYRIGHT=2026 BLOCKFIELD COMMAND
SEED_LOGIN_SECTOR=SECTOR 07 - NORTH RIDGE
SEED_LOGIN_SLOGAN=DEPLOY. CAPTURE. DOMINATE.
SEED_OPERATOR_HANDLE=KILO_7
SEED_OPERATOR_INITIALS=K7
SEED_OPERATOR_RANK=RANK - SERGEANT
SEED_SUPPORT_LABEL=SUPPORT
SEED_NETWORK_STATUS=NETWORK NOMINAL
SEED_UPDATE_DESCRIPTION=Synchronizing modpack assets with the primary deployment server. Do not close the launcher until the operation completes.
SEED_SETTINGS_PREFERENCES=/ LAUNCHER PREFERENCES

# ── Tauri client (set at build time via VITE_*) ──────────────────────────────

# API server URL
VITE_BLOCKFIELD_API_URL=http://localhost:3000/api/launcher/v1

# Branding — used as CMS fallback in the launcher UI
VITE_BRAND=BLOCKFIELD
VITE_BRAND_SUBTITLE=TACTICAL OPS
VITE_CHROME_TITLE=BLOCKFIELD LAUNCHER
VITE_OPERATION_NAME=IRON FRONT
VITE_SEASON=/ SEASON 01
VITE_SERVER_NAME=BLOCKFIELD - PRIMARY
VITE_LAUNCHER_VERSION=0.4.2
VITE_SERVER_IP=play.blockfield.gg:25565
VITE_SERVER_REGION=EU-WEST - 28ms
VITE_SERVER_PING=28
VITE_SERVER_REGION_CODE=EU-W
VITE_OPERATORS=142
VITE_COORDINATES=LAT 47.3829 / LON 19.0402
VITE_COPYRIGHT=2026 BLOCKFIELD COMMAND
VITE_OPERATOR_HANDLE=KILO_7
VITE_OPERATOR_INITIALS=K7
VITE_LOGIN_PLACEHOLDER=operator@blockfield.gg

# ── Minecraft launcher defaults (Rust backend) ───────────────────────────────

# Override Mojang API URLs (rarely needed, but prevents hard-rebuild on URL changes)
BLOCKFIELD_MOJANG_MANIFEST_URL=https://piston-meta.mojang.com/mc/game/version_manifest_v2.json
BLOCKFIELD_MOJANG_ASSET_BASE_URL=https://resources.download.minecraft.net

# Launcher identity sent to Minecraft
BLOCKFIELD_LAUNCHER_NAME=BlockfieldLauncher
BLOCKFIELD_OFFLINE_USERNAME=Blockfield

# Default Minecraft version when manifest is unavailable
BLOCKFIELD_MINECRAFT_VERSION=1.20.1

# Java binary name (platform-specific fallback, "java" or "java.exe")
# BLOCKFIELD_JAVA_BINARY=java

# Default launcher settings
BLOCKFIELD_DEFAULT_RAM_MB=8192
BLOCKFIELD_AUTO_UPDATE=true
BLOCKFIELD_DEFAULT_LANG=en

# Player name for offline mode
BLOCKFIELD_PLAYER_NAME=Blockfield

# ── GitHub Actions / CI ─────────────────────────────────────────────────────

# Docker image name for CI builds
# IMAGE_NAME=ghcr.io/netherg-io/blockfield-launcher-backend
